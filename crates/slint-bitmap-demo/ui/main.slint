// slint-bitmap 演示窗口：下游消费者的最小示例。
// 与 slint-bitmap 库内的 PixelPainterWindow 等价，这里以“消费者”身份
// 通过 `@slint_bitmap` 导入组件并自行组装，验证组件库的可复用性。

import { PixelPainter, PixelTitleBar } from "@slint_bitmap";

export component MainWindow inherits Window {
    title: "Slint 像素画板";
    no-frame: true;
    preferred-width: 720px;
    preferred-height: 560px;
    background: c-bg;

    // ---------- 主题 ----------
    property <color> c-bg: #ffffff;
    property <color> c-panel: #fbfbf9;
    property <color> c-panel-light: #f3f2ee;
    property <color> c-border: #ddd9d2;
    property <color> c-shadow: #48453f;
    property <color> c-text: #262626;
    property <color> c-dim: #9a968f;
    property <color> c-highlight: #ffec27;
    property <color> c-danger: #ff004d;

    // ---------- 与画板 widget 双向同步的状态 ----------
    in-out property <color> brush-color: #ff004d;
    in-out property <bool> eraser: false;
    in-out property <int> brush-size: 1;
    in-out property <image> canvas-image;
    in-out property <string> status-text: "就绪 —— 左键画 / 右键擦除，点击色板选色";

    // ---------- 转发回调（Rust 侧用 install_painter / install_title_bar_controls 接线） ----------
    callback paint(length, length, bool);
    callback clear-canvas();
    callback save-png();
    callback drag-start();
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        PixelTitleBar {
            title: "SLINT PIXEL PAINTER · 像素画板";
            bg: c-bg;
            text-color: c-dim;
            accent: c-highlight;
            btn-face: c-panel;
            btn-hover: c-panel-light;
            btn-icon: c-text;
            close-hover: c-danger;
            divider: c-shadow;
            drag-start => { root.drag-start(); }
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
        }

        PixelPainter {
            page: c-bg;
            panel: c-panel;
            panel-light: c-panel-light;
            edge: c-border;
            shadow: c-shadow;
            text-color: c-text;
            dim: c-dim;
            highlight: c-highlight;
            danger: c-danger;

            brush-color <=> root.brush-color;
            eraser <=> root.eraser;
            brush-size <=> root.brush-size;
            canvas-image <=> root.canvas-image;
            status-text <=> root.status-text;

            paint(px, py, erase) => { root.paint(px, py, erase); }
            clear-canvas => { root.clear-canvas(); }
            save-png => { root.save-png(); }
        }
    }
}