// slint-bitmap 组件画廊：展示全部像素风组件（也是复用教程的完整示例）。

import {
    PixelTitleBar, PixelButton, PixelCheckBox, PixelSwitch, PixelSlider,
    PixelTextInput, PixelProgressBar, PixelBadge, PixelPanel, PixelDialog,
    PixelRadioGroup, PixelComboBox, PixelMenu, PixelTableView, PixelScrollPanel,
    PixelCollapsible, PixelAccordion, PixelSidebar,
    PixelText, PixelTitle, PixelForm, PixelFormItem, PixelTextArea,
    PixelIconButton, PixelTooltip, PixelBubble, PixelPopconfirm,
} from "@slint_bitmap";

export component GalleryWindow inherits Window {
    title: "Slint 像素组件库";
    no-frame: true;
    preferred-width: 760px;
    preferred-height: 640px;
    background: c-bg;

    // ---------- 主题 ----------
    property <color> c-bg: #ffffff;
    property <color> c-panel: #fbfbf9;
    property <color> c-panel-light: #f3f2ee;
    property <color> c-border: #ddd9d2;
    property <color> c-shadow: #48453f;
    property <color> c-text: #262626;
    property <color> c-dim: #9a968f;
    property <color> c-highlight: #ffec27;
    property <color> c-danger: #ff004d;

    // ---------- 演示状态 ----------
    in-out property <bool> grid-enabled: true;
    in-out property <bool> sound-on: false;
    in-out property <float> slider-value: 60.0;
    in-out property <string> input-text: "像素";
    in-out property <int> radio-index: 1;
    in-out property <int> combo-index: 0;
    in-out property <int> menu-index: -1;
    in-out property <int> table-row: -1;
    in-out property <int> accordion-active: 1;
    in-out property <int> sidebar-active: 0;
    property <bool> collapsible-open: true;
    property <bool> dialog-open: false;
    in-out property <string> form-name: "像素小妖";
    in-out property <string> form-desc: "住在森林里的像素生物，会掉落金币。";
    in-out property <int> form-class: 1;
    in-out property <bool> popconfirm-open: false;
    property <bool> bubble-open: false;
    property <string> action-status: "就绪";

    // ---------- 回调（Rust 接线） ----------
    callback drag-start();
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback open-painter();
    callback dialog-accept();
    callback dialog-cancel();

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        PixelTitleBar {
            title: "SLINT WIDGET GALLERY · 像素组件库";
            bg: c-bg;
            text-color: c-dim;
            accent: c-highlight;
            btn-face: c-panel;
            btn-hover: c-panel-light;
            btn-icon: c-text;
            close-hover: c-danger;
            divider: c-shadow;
            drag-start => { root.drag-start(); }
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
        }

        // ===== 滚动面板：承载全部组件（单列，滚轮/拖动滚动） =====
        PixelScrollPanel {
            VerticalLayout {
                // 显式宽度：打破 ScrollView 视口宽度 ↔ 内容宽度的循环绑定
                width: root.width - 28px;
                spacing: 10px;
                PixelPanel {
                    title: "按钮 BUTTON";
                    HorizontalLayout {
                        spacing: 8px;
                        PixelButton { text: "画笔"; width: 90px; active: true; }
                        PixelButton { text: "橡皮擦"; width: 90px; }
                        PixelButton { text: "清空"; width: 90px; face: c-danger; face-active: #ff2f77; }
                    }
                }
                PixelPanel {
                    title: "复选 / 开关 CHECKBOX · SWITCH";
                    HorizontalLayout {
                        spacing: 12px;
                        PixelCheckBox { text: "启用网格"; width: 100px; checked <=> root.grid-enabled; }
                        PixelCheckBox { text: "自动保存"; width: 100px; }
                        PixelSwitch { checked <=> root.sound-on; }
                    }
                }
                PixelPanel {
                    title: "滑块 SLIDER";
                    VerticalLayout {
                        spacing: 6px;
                        PixelSlider { value <=> root.slider-value; }
                        Text { text: "值: " + Math.round(root.slider-value) + " / 100"; color: c-dim; font-size: 12px; }
                    }
                }
                PixelPanel {
                    title: "输入 TEXT INPUT";
                    VerticalLayout {
                        spacing: 6px;
                        PixelTextInput { text <=> root.input-text; placeholder: "输入文字…"; }
                        Text { text: "回显: " + root.input-text; color: c-dim; font-size: 12px; }
                    }
                }
                PixelPanel {
                    title: "单选框 RADIO";
                    PixelRadioGroup {
                        options: ["像素风", "扁平风", "拟物风"];
                        index <=> root.radio-index;
                    }
                }
                PixelPanel {
                    title: "下拉选择 COMBOBOX";
                    VerticalLayout {
                        spacing: 6px;
                        PixelComboBox {
                            model: ["#ff004d 红", "#ffa300 橙", "#ffec27 黄", "#00e436 绿", "#29adff 蓝"];
                            index <=> root.combo-index;
                        }
                        Text { text: "选中: " + (root.combo-index >= 0 ? "[" + root.combo-index + "]" : "无"); color: c-dim; font-size: 12px; }
                    }
                }
                PixelPanel {
                    title: "进度 PROGRESS";
                    VerticalLayout {
                        spacing: 6px;
                        PixelProgressBar { progress: root.slider-value / 100.0; show-text: true; }
                        PixelProgressBar { progress: 0.35; }
                        PixelProgressBar { progress: 0.85; show-text: true; }
                    }
                }
                PixelPanel {
                    title: "徽章 BADGE";
                    HorizontalLayout {
                        spacing: 8px;
                        PixelBadge { text: "NEW"; width: 60px; face: c-danger; }
                        PixelBadge { text: "PICO-8"; width: 76px; face: c-highlight; }
                        PixelBadge { text: "16×16"; width: 76px; face: #29adff; }
                    }
                }
                PixelPanel {
                    title: "提示 TOOLTIP";
                    HorizontalLayout {
                        spacing: 8px;
                        PixelButton {
                            text: "悬停看提示"; width: 120px;
                            // Slint 内置 Tooltip：延迟出现、跟随指针（样式跟随活动主题）
                            Tooltip { text: @markdown("**我是提示气泡**"); }
                        }
                    }
                }
                PixelPanel {
                    title: "菜单 MENU";
                    VerticalLayout {
                        spacing: 6px;
                        PixelMenu {
                            items: ["新建文件", "打开…", "---", "保存", "另存为…", "---", "退出"];
                            index <=> root.menu-index;
                            button-text: "文件菜单";
                        }
                        Text { text: "选择: " + (root.menu-index >= 0 ? root.menu-index : "无"); color: c-dim; font-size: 12px; }
                    }
                }
                PixelPanel {
                    title: "表格 TABLE";
                    PixelTableView {
                        headers: ["精灵", "HP", "攻击"];
                        rows: [
                            ["小妖", "12", "3"],
                            ["骷髅", "20", "5"],
                            ["石魔", "45", "8"],
                            ["龙", "90", "15"]
                        ];
                        selected-row <=> root.table-row;
                    }
                }
                PixelPanel {
                    title: "手风琴 ACCORDION";
                    PixelAccordion {
                        titles: ["第一章 启程", "第二章 森林", "第三章 城堡"];
                        contents: ["你醒来时发现自己在一片像素草地上。", "幽暗的森林里藏着宝箱与陷阱。", "城堡的大门缓缓打开，冒险继续。"];
                        active <=> root.accordion-active;
                    }
                }
                PixelPanel {
                    title: "折叠 COLLAPSIBLE";
                    PixelCollapsible {
                        title: "使用说明";
                        expanded <=> root.collapsible-open;
                        Text {
                            text: "点击标题栏展开/收起。内容区带高度动画。";
                            color: c-text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
                PixelPanel {
                    title: "侧边栏 SIDEBAR";
                    PixelSidebar {
                        height: 160px;
                        items: ["画布", "图层", "调色板", "导出"];
                        active <=> root.sidebar-active;
                        title: "导航";
                        Text {
                            text: "当前页面: " + ["画布", "图层", "调色板", "导出"][root.sidebar-active];
                            color: c-text;
                            font-size: 13px;
                        }
                    }
                }
                PixelPanel {
                    title: "表单 FORM";
                    PixelForm {
                        spacing: 10px;
                        PixelFormItem {
                            label: "名称";
                            PixelTextInput { text <=> root.form-name; }
                        }
                        PixelFormItem {
                            label: "描述";
                            PixelTextArea { text <=> root.form-desc; placeholder: "写点什么…"; }
                        }
                        PixelFormItem {
                            label: "分类";
                            PixelComboBox {
                                model: ["普通", "稀有", "传说"];
                                index <=> root.form-class;
                            }
                        }
                        PixelFormItem {
                            label: "状态";
                            PixelText { text: root.action-status; color: c-dim; }
                        }
                    }
                }
                PixelPanel {
                    title: "文本 TEXT";
                    VerticalLayout {
                        spacing: 6px;
                        PixelTitle { text: "像素小标题 PIXEL TITLE"; }
                        PixelText { text: "正文：这是一段像素风文本，用 PixelText 统一字号。"; }
                        PixelText { text: "次要说明文字，用 color 覆盖即可。"; color: c-dim; }
                    }
                }
                PixelPanel {
                    title: "图标按钮 ICON";
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            PixelIconButton { icon: "×"; clicked => { root.action-status = "点击了关闭图标"; } }
                            // 右上角数字角标（PixelBadge 作角标）
                            PixelBadge { text: "3"; x: 24px; y: -6px; width: 22px; height: 16px; face: c-danger; text-color: #ffffff; font-size: 10px; }
                        }
                        PixelIconButton { icon: "✓"; clicked => { root.action-status = "点击了确认图标"; } }
                        PixelIconButton { icon: "▲"; active: true; clicked => { root.action-status = "点击了上箭头"; } }
                        PixelIconButton { icon: "★"; clicked => { root.action-status = "点击了星标"; } }
                        PixelIconButton { icon: "♥"; clicked => { root.action-status = "点击了爱心"; } }
                    }
                }
                PixelPanel {
                    title: "气泡 TOOLTIP · BUBBLE";
                    HorizontalLayout {
                        spacing: 12px;
                        PixelTooltip {
                            text: "这是像素风悬停提示气泡";
                            PixelButton { text: "悬停我"; width: 90px; }
                        }
                        PixelBubble {
                            icon: "ⓘ";
                            title: "使用说明";
                            open: root.bubble-open;
                            PixelText { text: "气泡内容插槽可以放任意组件，点外部自动关闭。"; }
                            PixelButton {
                                text: "知道了"; width: 90px;
                                clicked => { root.bubble-open = false; }
                            }
                        }
                    }
                }
                PixelPanel {
                    title: "确认 POPCONFIRM";
                    VerticalLayout {
                        spacing: 6px;
                        PixelPopconfirm {
                            text: "确定要删除这个像素小妖吗？此操作不可撤销。";
                            button-text: "删除角色";
                            open: root.popconfirm-open;
                            confirm => { root.action-status = "已确认删除"; }
                            cancel => { root.action-status = "已取消删除"; }
                        }
                        PixelText { text: root.action-status; color: c-dim; }
                    }
                }
                PixelPanel {
                    title: "对话框 DIALOG";
                    HorizontalLayout {
                        spacing: 8px;
                        PixelButton {
                            text: "打开对话框"; width: 140px;
                            clicked => { root.dialog-open = true; }
                        }
                    }
                }
                PixelPanel {
                    title: "画板 PAINTER";
                    HorizontalLayout {
                        spacing: 8px;
                        PixelButton {
                            text: "打开像素画板 →"; width: 160px; face: #29adff;
                            clicked => { root.open-painter(); }
                        }
                    }
                }
            }
        }
    }

    // ===== 模态对话框（覆盖层） =====
    PixelDialog {
        open: root.dialog-open;
        title: "像素对话框";
        Text {
            text: "这是 PixelDialog 的内容插槽，可以放任意组件。点击确定或取消关闭。";
            color: c-text;
            font-size: 13px;
            wrap: word-wrap;
        }
        accept => {
            root.dialog-accept();
            root.dialog-open = false;
        }
        cancel => {
            root.dialog-cancel();
            root.dialog-open = false;
        }
    }
}