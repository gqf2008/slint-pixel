import { PixelTheme } from "pixel_theme.slint";
import { PixelButton } from "pixel_painter_widget.slint";

// ============================================================================
// slint-pixel · 第二轮补齐：列表/数据表/搜索/通知/导航
// ============================================================================

// ===== 头像组 =====
export component PixelAvatarGroup inherits Rectangle {
    in property <[string]> names: [];
    in property <length> size: 30px;
    in property <color> face: PixelTheme.hover;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    width: root.names.length * root.size - Math.max(root.names.length - 1, 0) * 10px;
    height: root.size;

    for name[i] in root.names : Rectangle {
        x: i * (root.size - 10px);
        y: 0px; width: root.size; height: root.size;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            Text {
                text: name;
                color: root.text-color;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// ===== 通用列表 =====
export component PixelList inherits Rectangle {
    in property <[string]> items: [];
    in-out property <int> selected: -1;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> face-hover: PixelTheme.hover;
    in property <color> face-selected: PixelTheme.accent;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    callback item-selected(index: int);
    preferred-height: root.items.length * 30px + 4px;
    min-height: root.items.length * 30px + 4px;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            clip: true;
            VerticalLayout {
                padding: 1px; spacing: 0px;
                for item[i] in root.items : Rectangle {
                    height: 30px;
                    background: root.selected == i ? root.face-selected
                        : (list-ta.has-hover ? root.face-hover : transparent);
                    Text {
                        x: 10px; width: parent.width - 20px; height: parent.height;
                        text: item;
                        color: root.selected == i ? #ffffff : root.text-color;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    list-ta := TouchArea {
                        enabled: root.enabled;
                        clicked => {
                            root.selected = i;
                            root.item-selected(i);
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}

// ===== 虚拟列表（轻量：裁剪容器 + 复用 List 结构） =====
export component PixelVirtualList inherits Rectangle {
    in property <[string]> items: [];
    in-out property <int> selected: -1;
    in property <length> viewport-height: 160px;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> face-hover: PixelTheme.hover;
    in property <color> face-selected: PixelTheme.accent;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    callback item-selected(index: int);
    height: root.viewport-height;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            clip: true;
            VerticalLayout {
                padding: 1px; spacing: 0px;
                for item[i] in root.items : Rectangle {
                    height: 30px;
                    background: root.selected == i ? root.face-selected
                        : (virt-ta.has-hover ? root.face-hover : transparent);
                    Text {
                        x: 10px; width: parent.width - 20px; height: parent.height;
                        text: item;
                        color: root.selected == i ? #ffffff : root.text-color;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    virt-ta := TouchArea {
                        enabled: root.enabled;
                        clicked => {
                            root.selected = i;
                            root.item-selected(i);
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}

// ===== 树形表格 =====
export component PixelTreeTable inherits Rectangle {
    in property <[string]> headers: [];
    in property <[[string]]> rows: [];
    in property <[int]> levels: [];
    in-out property <int> selected-row: -1;
    in property <bool> enabled: true;
    in property <length> header-height: 28px;
    in property <length> row-height: 28px;
    in property <color> face: PixelTheme.bg;
    in property <color> header-face: PixelTheme.panel;
    in property <color> row-selected: PixelTheme.accent;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> dim: PixelTheme.dim;
    callback row-clicked(row: int);
    preferred-height: root.header-height + root.row-height * root.rows.length + 4px;
    min-height: root.header-height + root.row-height * root.rows.length + 4px;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            clip: true;
            // 表头
            Rectangle {
                height: root.header-height;
                background: root.header-face;
                HorizontalLayout {
                    for h in root.headers : Text {
                        text: h;
                        color: root.dim;
                        font-weight: 700;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            // 行
            VerticalLayout {
                y: root.header-height;
                for r[i] in root.rows : Rectangle {
                    height: root.row-height;
                    background: root.selected-row == i ? root.row-selected : transparent;
                    HorizontalLayout {
                        for cell in r : Text {
                            text: cell;
                            color: root.selected-row == i ? #ffffff : root.text-color;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                    row-ta := TouchArea {
                        clicked => {
                            root.selected-row = i;
                            root.row-clicked(i);
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}

// ===== 数据表格（带排序请求） =====
export component PixelDataTable inherits Rectangle {
    in property <[string]> headers: [];
    in property <[[string]]> rows: [];
    in-out property <int> selected-row: -1;
    in-out property <int> sort-column: -1;
    in property <bool> enabled: true;
    in property <length> header-height: 28px;
    in property <length> row-height: 26px;
    in property <color> face: PixelTheme.bg;
    in property <color> header-face: PixelTheme.panel;
    in property <color> row-even: PixelTheme.bg;
    in property <color> row-odd: PixelTheme.bg;
    in property <color> row-selected: PixelTheme.accent;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> dim: PixelTheme.dim;
    callback row-clicked(row: int);
    callback sort-requested(column: int);
    preferred-height: root.header-height + root.row-height * root.rows.length + 4px;
    min-height: root.header-height + root.row-height * root.rows.length + 4px;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            clip: true;
            Rectangle {
                height: root.header-height;
                background: root.header-face;
                HorizontalLayout {
                    for h[j] in root.headers : Rectangle {
                        background: header-ta.has-hover ? root.row-odd : transparent;
                        Text {
                            text: h + (root.sort-column == j ? " ↕" : "");
                            color: root.dim;
                            font-weight: 700;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        header-ta := TouchArea {
                            clicked => {
                                root.sort-column = j;
                                root.sort-requested(j);
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
            VerticalLayout {
                y: root.header-height;
                for r[i] in root.rows : Rectangle {
                    height: root.row-height;
                    background: root.selected-row == i ? root.row-selected
                        : (Math.mod(i, 2) == 0 ? root.row-even : root.row-odd);
                    HorizontalLayout {
                        for cell in r : Text {
                            text: cell;
                            color: root.selected-row == i ? #ffffff : root.text-color;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    row-ta := TouchArea {
                        clicked => {
                            root.selected-row = i;
                            root.row-clicked(i);
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}

// ===== 搜索框 =====
export component PixelSearchBox inherits Rectangle {
    in-out property <string> query: "";
    in property <string> placeholder: "搜索...";
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> border-focus: PixelTheme.accent;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> dim: PixelTheme.dim;
    callback search(query: string);
    callback clear;
    height: 32px;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px;
            border-color: search-input.has-focus ? root.border-focus : root.border;
            search-input := TextInput {
                x: 6px; width: parent.width - 40px; height: parent.height;
                text <=> root.query;
                single-line: true;
                vertical-alignment: center;
                accepted => { root.search(root.query); }
            }
            Text {
                visible: root.query == "";
                x: 8px; width: parent.width - 42px; height: parent.height;
                text: root.placeholder;
                color: root.dim;
                font-size: 12px;
                vertical-alignment: center;
            }
            PixelButton {
                x: parent.width - 30px; width: 26px; height: 26px;
                text: root.query == "" ? "⌕" : "×";
                clicked => {
                    if root.query == "" { root.search(root.query); } else { root.query = ""; root.clear(); }
                }
            }
        }
    }
}

// ===== 通知中心 =====
export component PixelNotificationCenter inherits Rectangle {
    in property <[string]> messages: [];
    in-out property <int> active: -1;
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> dim: PixelTheme.dim;
    callback dismiss(index: int);
    preferred-height: root.messages.length * 32px + 4px;
    min-height: root.messages.length * 32px + 4px;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            VerticalLayout {
                padding: 2px; spacing: 0px;
                for msg[i] in root.messages : Rectangle {
                    height: 32px;
                    background: root.active == i ? root.border : transparent;
                    Text {
                        x: 8px; width: parent.width - 32px; height: parent.height;
                        text: msg;
                        color: root.active == i ? #ffffff : root.text-color;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        x: parent.width - 24px; width: 20px; height: parent.height;
                        text: "×";
                        color: root.dim;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    nc-ta := TouchArea {
                        clicked => {
                            root.active = i;
                            root.dismiss(i);
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}

// ===== 二级菜单 =====
export component PixelSubMenu inherits Rectangle {
    in property <[string]> items: [];
    in property <[[string]]> children: [];
    in-out property <int> parent-index: -1;
    in-out property <int> child-index: -1;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> face-hover: PixelTheme.hover;
    in property <color> face-active: PixelTheme.accent;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    callback selected(parent: int, child: int);
    height: 40px;
    opacity: root.enabled ? 1.0 : 0.5;

    HorizontalLayout {
        spacing: 2px;
        for item[i] in root.items : Rectangle {
            width: 90px; height: 100%;
            background: root.parent-index == i ? root.face-active : root.face-hover;
            Text {
                text: item;
                color: root.parent-index == i ? #ffffff : root.text-color;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            sm-ta := TouchArea {
                clicked => {
                    root.parent-index = i;
                    root.child-index = -1;
                }
                mouse-cursor: pointer;
            }
        }
    }

    if root.parent-index >= 0 && root.parent-index < root.children.length : Rectangle {
        y: 40px;
        width: 180px; height: root.children[root.parent-index].length * 28px + 4px;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            VerticalLayout {
                for child[j] in root.children[root.parent-index] : Rectangle {
                    height: 28px;
                    background: root.child-index == j ? root.face-active : transparent;
                    Text {
                        text: child;
                        color: root.child-index == j ? #ffffff : root.text-color;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    child-ta := TouchArea {
                        clicked => {
                            root.child-index = j;
                            root.selected(root.parent-index, root.child-index);
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}

// ===== 回到顶部 =====
export component PixelBackTop inherits Rectangle {
    in property <color> face: PixelTheme.hover;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    callback clicked;
    width: 36px; height: 36px;
    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            Text {
                text: "↑";
                color: PixelTheme.text;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        bt-ta := TouchArea {
            clicked => { root.clicked(); }
            mouse-cursor: pointer;
        }
    }
}

// ===== 固钉容器 =====
export component PixelAffix inherits Rectangle {
    in property <bool> fixed: false;
    @children
}

// ===== 吸顶容器 =====
export component PixelSticky inherits Rectangle {
    in property <length> top: 0px;
    @children
}
