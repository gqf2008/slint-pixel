import { PixelTheme } from "pixel_theme.slint";
import { PixelButton } from "pixel_painter_widget.slint";

// ============================================================================
// slint-pixel · 专业场景组件（层级、范围、上传、时间线、轮播、分栏）
//
// 组件清单：
//   PixelRangeSlider   双滑块范围选择
//   PixelTree          扁平层级树（items + levels）
//   PixelTreeSelect    树形下拉选择
//   PixelTransfer      双栏穿梭框（回调驱动）
//   PixelUpload        上传/文件选择视觉组件
//   PixelTimeline      时间线
//   PixelCarousel      轮播
//   PixelSplitPane     可拖拽分栏
// ============================================================================

// ===== 范围滑块 =====
export component PixelRangeSlider inherits Rectangle {
    in-out property <float> lower: 20.0;
    in-out property <float> upper: 80.0;
    in property <float> min: 0.0;
    in property <float> max: 100.0;
    in property <bool> enabled: true;
    in property <color> track: PixelTheme.panel;
    in property <color> fill: PixelTheme.accent;
    in property <color> thumb: PixelTheme.accent;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    callback changed(lower: float, upper: float);
    height: 30px;
    opacity: root.enabled ? 1.0 : 0.5;

    property <float> lower-ratio: (root.lower - root.min) / Math.max(root.max - root.min, 0.0001);
    property <float> upper-ratio: (root.upper - root.min) / Math.max(root.max - root.min, 0.0001);

    Rectangle {
        x: 12px; y: 12px;
        width: root.width - 24px; height: 6px;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px;
            width: parent.width - 2px; height: 4px;
            background: root.track;
            border-width: 1px;
            border-color: root.border;
            Rectangle {
                x: parent.width * root.lower-ratio;
                width: Math.max(parent.width * (root.upper-ratio - root.lower-ratio), 0px);
                height: 2px;
                background: root.fill;
            }
        }
    }

    // 下界滑块
    Rectangle {
        x: 12px + (root.width - 24px) * root.lower-ratio - 8px;
        y: 2px; width: 18px; height: 26px;
        background: root.shadow;
        Rectangle {
            x: lower-ta.pressed ? 1px : 0px;
            y: lower-ta.pressed ? 1px : 0px;
            width: 18px; height: 26px;
            background: root.thumb;
            border-width: 2px;
            border-color: root.border;
        }
    }
    lower-ta := TouchArea {
        x: 12px + (root.width - 24px) * root.lower-ratio - 8px;
        y: 2px; width: 18px; height: 26px;
        enabled: root.enabled;
        pointer-event(ev) => {
            if ev.button != PointerEventButton.left { return; }
            if ev.kind == PointerEventKind.down {
                root.set-lower(self.mouse-x);
            }
        }
        moved => {
            if self.pressed {
                root.set-lower(self.mouse-x);
            }
        }
        mouse-cursor: pointer;
    }

    // 上界滑块
    Rectangle {
        x: 12px + (root.width - 24px) * root.upper-ratio - 8px;
        y: 2px; width: 18px; height: 26px;
        background: root.shadow;
        Rectangle {
            x: upper-ta.pressed ? 1px : 0px;
            y: upper-ta.pressed ? 1px : 0px;
            width: 18px; height: 26px;
            background: root.thumb;
            border-width: 2px;
            border-color: root.border;
        }
    }
    upper-ta := TouchArea {
        x: 12px + (root.width - 24px) * root.upper-ratio - 8px;
        y: 2px; width: 18px; height: 26px;
        enabled: root.enabled;
        pointer-event(ev) => {
            if ev.button != PointerEventButton.left { return; }
            if ev.kind == PointerEventKind.down {
                root.set-upper(self.mouse-x);
            }
        }
        moved => {
            if self.pressed {
                root.set-upper(self.mouse-x);
            }
        }
        mouse-cursor: pointer;
    }

    function set-lower(x: length) {
        root.lower = Math.max(root.min, Math.min(root.upper,
            root.min + (x - 12px) * (root.max - root.min) / Math.max(root.width - 24px, 1px)));
        root.changed(root.lower, root.upper);
    }
    function set-upper(x: length) {
        root.upper = Math.min(root.max, Math.max(root.lower,
            root.min + (x - 12px) * (root.max - root.min) / Math.max(root.width - 24px, 1px)));
        root.changed(root.lower, root.upper);
    }
}

// ===== 扁平层级树 =====
export component PixelTree inherits Rectangle {
    in property <[string]> items: [];
    in property <[int]> levels: [];
    in-out property <int> selected: -1;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> face-hover: PixelTheme.hover;
    in property <color> face-selected: PixelTheme.accent;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    callback item-selected(index: int);
    preferred-height: root.items.length * 28px + 4px;
    min-height: root.items.length * 28px + 4px;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            clip: true;
            VerticalLayout {
                padding: 1px;
                spacing: 0px;
                for item[i] in root.items : Rectangle {
                    height: 28px;
                    background: root.selected == i ? root.face-selected
                        : (tree-ta.has-hover ? root.face-hover : transparent);
                    Text {
                        x: 8px + root.levels[i] * 18px;
                        width: parent.width - 16px - root.levels[i] * 18px;
                        height: parent.height;
                        text: item;
                        color: root.selected == i ? #ffffff : root.text-color;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    tree-ta := TouchArea {
                        enabled: root.enabled;
                        clicked => {
                            root.selected = i;
                            root.item-selected(i);
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}

// ===== 树形下拉选择 =====
export component PixelTreeSelect inherits Rectangle {
    in property <[string]> items: [];
    in property <[int]> levels: [];
    in-out property <int> index: -1;
    in-out property <bool> open: false;
    in property <string> placeholder: "请选择";
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> border-focus: PixelTheme.accent;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> dim: PixelTheme.dim;
    callback selected(index: int);
    height: 32px;
    opacity: root.enabled ? 1.0 : 0.5;

    init => {
        if root.open { popup.show(); }
    }

    Rectangle {
        width: 100%; height: root.height;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px;
            border-color: popup.is-open ? root.border-focus : root.border;
            Text {
                x: 8px; width: parent.width - 36px; height: parent.height;
                text: root.index >= 0 && root.index < root.items.length ? root.items[root.index] : root.placeholder;
                color: root.index >= 0 && root.index < root.items.length ? root.text-color : root.dim;
                font-size: 12px;
                vertical-alignment: center;
            }
            Text {
                x: parent.width - 26px; width: 20px; height: parent.height;
                text: popup.is-open ? "▲" : "▼";
                color: root.dim;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ta := TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.open = !root.open;
                    if root.open { popup.show(); } else { popup.close(); }
                }
                mouse-cursor: pointer;
            }
        }
    }

    popup := PopupWindow {
        x: 0px; y: root.height + 2px;
        width: 220px;
        height: root.items.length * 28px + 10px;
        close-policy: close-on-click-outside;
        PixelTree {
            items: root.items;
            levels: root.levels;
            selected: root.index;
            item-selected(i) => {
                root.index = i;
                root.open = false;
                root.selected(i);
                popup.close();
            }
        }
    }
}

// ===== 双栏穿梭框 =====
export component PixelTransfer inherits Rectangle {
    in property <[string]> left-items: [];
    in property <[string]> right-items: [];
    in-out property <int> left-index: -1;
    in-out property <int> right-index: -1;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    callback move-to-right(index: int);
    callback move-to-left(index: int);
    height: 200px;
    width: 320px;
    opacity: root.enabled ? 1.0 : 0.5;

    HorizontalLayout {
        spacing: 8px;
        // 左栏
        Rectangle {
            width: (parent.width - 40px) / 2;
            height: 100%;
            background: root.shadow;
            Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                background: root.face;
                border-width: 2px; border-color: root.border;
                VerticalLayout {
                    padding: 4px; spacing: 2px;
                    for item[i] in root.left-items : Rectangle {
                        height: 24px;
                        background: root.left-index == i ? root.border : transparent;
                        Text {
                            text: item; color: root.left-index == i ? #ffffff : root.text-color;
                            font-size: 12px; vertical-alignment: center;
                        }
                        left-ta := TouchArea {
                            clicked => { root.left-index = i; }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
        // 操作按钮
        VerticalLayout {
            spacing: 8px;
            width: 32px;
            PixelButton { text: "→"; clicked => { root.move-to-right(root.left-index); } }
            PixelButton { text: "←"; clicked => { root.move-to-left(root.right-index); } }
        }
        // 右栏
        Rectangle {
            width: (parent.width - 40px) / 2;
            height: 100%;
            background: root.shadow;
            Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                background: root.face;
                border-width: 2px; border-color: root.border;
                VerticalLayout {
                    padding: 4px; spacing: 2px;
                    for item[i] in root.right-items : Rectangle {
                        height: 24px;
                        background: root.right-index == i ? root.border : transparent;
                        Text {
                            text: item; color: root.right-index == i ? #ffffff : root.text-color;
                            font-size: 12px; vertical-alignment: center;
                        }
                        right-ta := TouchArea {
                            clicked => { root.right-index = i; }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }
}

// ===== 上传/文件选择 =====
export component PixelUpload inherits Rectangle {
    in property <string> file-name: "";
    in property <string> hint: "拖拽或点击选择文件";
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> face-hover: PixelTheme.hover;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> dim: PixelTheme.dim;
    callback browse;
    callback clear;
    height: 80px;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: upload-ta.has-hover ? root.face-hover : root.face;
            border-width: 2px; border-color: root.border;
            Text {
                y: 20px; width: 100%; height: 20px;
                text: root.file-name == "" ? root.hint : root.file-name;
                color: root.file-name == "" ? root.dim : root.text-color;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Text {
                y: 42px; width: 100%; height: 18px;
                text: "点击选择 / 清除";
                color: root.dim;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            upload-ta := TouchArea {
                enabled: root.enabled;
                clicked => {
                    if root.file-name == "" { root.browse(); } else { root.clear(); }
                }
                mouse-cursor: pointer;
            }
        }
    }
}

// ===== 时间线 =====
export component PixelTimeline inherits Rectangle {
    in property <[string]> items: [];
    in-out property <int> current: -1;
    in property <color> face: PixelTheme.bg;
    in property <color> dot: PixelTheme.accent;
    in property <color> line: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> dim: PixelTheme.dim;
    callback item-selected(index: int);
    preferred-height: root.items.length * 36px;
    min-height: root.items.length * 36px;

    VerticalLayout {
        spacing: 0px;
        for item[i] in root.items : Rectangle {
            height: 36px;
            // 左侧圆点
            Rectangle {
                x: 6px; y: 10px; width: 12px; height: 12px;
                background: root.shadow;
                Rectangle {
                    x: 1px; y: 1px; width: 10px; height: 10px;
                    background: root.current == i ? root.dot : root.face;
                    border-width: 2px; border-color: root.line;
                }
            }
            // 连接线
            Rectangle {
                visible: i < root.items.length - 1;
                x: 11px; y: 22px; width: 2px; height: 14px;
                background: root.line;
            }
            Text {
                x: 28px; y: 0px; width: parent.width - 28px; height: parent.height;
                text: item;
                color: root.current == i ? root.text-color : root.dim;
                font-size: 12px;
                vertical-alignment: center;
            }
            timeline-ta := TouchArea {
                clicked => {
                    root.current = i;
                    root.item-selected(i);
                }
                mouse-cursor: pointer;
            }
        }
    }
}

// ===== 轮播 =====
export component PixelCarousel inherits Rectangle {
    in property <[string]> slides: [];
    in-out property <int> index: 0;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    callback changed(index: int);
    height: 120px;
    opacity: root.enabled ? 1.0 : 0.5;

    property <string> current-text: root.slides.length > 0 && root.index >= 0 && root.index < root.slides.length
        ? root.slides[root.index] : "";

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            Text {
                x: 40px; y: 10px; width: parent.width - 80px; height: 60px;
                text: root.current-text;
                color: root.text-color;
                font-size: 14px;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            PixelButton {
                text: "‹";
                x: 6px; y: 40px; width: 28px; height: 28px;
                clicked => {
                    root.index = root.slides.length > 0 ? Math.max(0, root.index - 1) : 0;
                    root.changed(root.index);
                }
            }
            PixelButton {
                text: "›";
                x: parent.width - 34px; y: 40px; width: 28px; height: 28px;
                clicked => {
                    root.index = root.slides.length > 0 ? Math.min(root.slides.length - 1, root.index + 1) : 0;
                    root.changed(root.index);
                }
            }
            // 圆点指示器
            HorizontalLayout {
                y: 96px; width: 100%; height: 16px;
                alignment: center;
                spacing: 6px;
                for s[i] in root.slides : Rectangle {
                    width: 10px; height: 10px;
                    background: root.shadow;
                    Rectangle {
                        x: 1px; y: 1px; width: 8px; height: 8px;
                        background: root.index == i ? root.border : root.face;
                        border-width: 2px; border-color: root.border;
                    }
                }
            }
        }
    }
}

// ===== 可拖拽分栏 =====
// Slint 1.17 不向用户组件暴露 component-factory/ComponentContainer，
// 因此这里提供轻量分栏：左侧放 @children，右侧为可选的标题/说明文字。
export component PixelSplitPane inherits Rectangle {
    in-out property <float> ratio: 0.5;
    in property <string> right-title: "";
    in property <string> right-hint: "";
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> dim: PixelTheme.dim;
    callback ratio-changed(ratio: float);
    height: 200px;

    // 左窗格
    Rectangle {
        x: 0px; y: 0px;
        width: Math.max(0px, root.width * root.ratio - 4px);
        height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            @children
        }
    }
    // 分隔条
    Rectangle {
        x: root.width * root.ratio - 4px;
        y: 0px; width: 8px; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 3px; y: 0px; width: 2px; height: 100%;
            background: root.border;
        }
        split-ta := TouchArea {
            moved => {
                if self.pressed {
                    root.ratio = Math.max(0.1, Math.min(0.9, self.mouse-x / Math.max(root.width, 1px)));
                    root.ratio-changed(root.ratio);
                }
            }
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.ratio = Math.max(0.1, Math.min(0.9, self.mouse-x / Math.max(root.width, 1px)));
                    root.ratio-changed(root.ratio);
                }
            }
            mouse-cursor: ew-resize;
        }
    }
    // 右窗格
    Rectangle {
        x: root.width * root.ratio + 4px;
        width: Math.max(0px, root.width * (1.0 - root.ratio) - 4px);
        height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            Text {
                y: 12px; width: 100%; height: 20px;
                text: root.right-title;
                color: root.text-color;
                font-weight: 700;
                font-size: 13px;
                horizontal-alignment: center;
            }
            Text {
                y: 36px; width: 100%; height: 16px;
                text: root.right-hint;
                color: root.dim;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }
    }
}
