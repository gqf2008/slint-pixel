import { PixelTheme } from "pixel_theme.slint";
import { PixelButton } from "pixel_painter_widget.slint";
import { PixelTextInput } from "pixel_widgets.slint";
import { PixelNumberInput, PixelColorPicker } from "pixel_more.slint";

// ============================================================================
// slint-pixel · 高级组件 P1：向导 / 穿梭 / 看板 / 命令 / 输入类
// ============================================================================

// ===== 向导 =====
export component PixelWizard inherits Rectangle {
    in property <[string]> steps: [];
    in-out property <int> current: 0;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    callback previous;
    callback next;
    callback finish;
    height: 200px;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            VerticalLayout {
                padding: 8px; spacing: 8px;
                Text {
                    text: root.steps.length > root.current ? root.steps[root.current] : "";
                    color: PixelTheme.text;
                    font-weight: 700; font-size: 14px;
                }
                @children
                HorizontalLayout {
                    alignment: end;
                    PixelButton { text: "上一步"; clicked => { root.previous(); } }
                    PixelButton { text: root.current == root.steps.length - 1 ? "完成" : "下一步"; clicked => { if root.current == root.steps.length - 1 { root.finish(); } else { root.next(); } } }
                }
            }
        }
    }
}

// ===== 多步表单 =====
export component PixelMultiStepForm inherits Rectangle {
    in property <[string]> titles: [];
    in property <[string]> descriptions: [];
    in-out property <int> current: 0;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    callback step-changed(index: int);
    callback finish;
    height: 170px;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            VerticalLayout {
                padding: 8px; spacing: 6px;
                HorizontalLayout {
                    for t[i] in root.titles : Rectangle {
                        width: root.width / root.titles.length;
                        height: 24px;
                        background: root.current == i ? root.border : transparent;
                        Text {
                            text: t;
                            color: root.current == i ? #ffffff : PixelTheme.text;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    text: root.descriptions.length > root.current ? root.descriptions[root.current] : "";
                    color: PixelTheme.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                @children
                PixelButton {
                    text: root.current == root.titles.length - 1 ? "完成" : "下一步";
                    clicked => {
                        if root.current < root.titles.length - 1 {
                            root.current = root.current + 1;
                            root.step-changed(root.current);
                        } else {
                            root.finish();
                        }
                    }
                }
            }
        }
    }
}

// ===== 穿梭框 Pro =====
export component PixelTransferPro inherits Rectangle {
    in property <[string]> left-items: [];
    in property <[string]> right-items: [];
    in-out property <string> left-query: "";
    in-out property <string> right-query: "";
    in-out property <int> left-index: -1;
    in-out property <int> right-index: -1;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    callback move-to-right(index: int);
    callback move-to-left(index: int);
    callback move-all-right;
    callback move-all-left;
    height: 200px;
    width: 340px;
    opacity: root.enabled ? 1.0 : 0.5;

    HorizontalLayout {
        spacing: 6px;
        Rectangle {
            width: (parent.width - 44px) / 2;
            height: 100%;
            background: root.shadow;
            Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                background: root.face;
                border-width: 2px; border-color: root.border;
                VerticalLayout {
                    padding: 4px; spacing: 2px;
                    PixelTextInput { text <=> root.left-query; placeholder: "搜索"; height: 24px; }
                    for item[i] in root.left-items : Rectangle {
                        visible: root.left-query == "" || item == root.left-query;
                        height: 24px;
                        background: root.left-index == i ? root.border : transparent;
                        Text { text: item; color: root.left-index == i ? #ffffff : root.text-color; font-size: 11px; vertical-alignment: center; }
                        left-ta := TouchArea { clicked => { root.left-index = i; } mouse-cursor: pointer; }
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            width: 32px;
            PixelButton { text: ">"; clicked => { root.move-to-right(root.left-index); } }
            PixelButton { text: ">>"; clicked => { root.move-all-right(); } }
            PixelButton { text: "<"; clicked => { root.move-to-left(root.right-index); } }
            PixelButton { text: "<<"; clicked => { root.move-all-left(); } }
        }
        Rectangle {
            width: (parent.width - 44px) / 2;
            height: 100%;
            background: root.shadow;
            Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                background: root.face;
                border-width: 2px; border-color: root.border;
                VerticalLayout {
                    padding: 4px; spacing: 2px;
                    PixelTextInput { text <=> root.right-query; placeholder: "搜索"; height: 24px; }
                    for item[i] in root.right-items : Rectangle {
                        visible: root.right-query == "" || item == root.right-query;
                        height: 24px;
                        background: root.right-index == i ? root.border : transparent;
                        Text { text: item; color: root.right-index == i ? #ffffff : root.text-color; font-size: 11px; vertical-alignment: center; }
                        right-ta := TouchArea { clicked => { root.right-index = i; } mouse-cursor: pointer; }
                    }
                }
            }
        }
    }
}

// ===== 看板 Pro =====
export component PixelKanbanPro inherits Rectangle {
    in property <[string]> columns: [];
    in property <[[string]]> cards: [];
    in-out property <int> active-column: 0;
    in-out property <int> drag-column: -1;
    in-out property <int> drag-card: -1;
    in-out property <int> drop-column: -1;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> header-face: PixelTheme.panel;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    callback card-clicked(column: int, card: int);
    callback drag-start(column: int, card: int);
    callback drag-over(column: int);
    callback drop(column: int, card: int, target: int);
    height: 220px;
    opacity: root.enabled ? 1.0 : 0.5;

    HorizontalLayout {
        spacing: 6px;
        for col[j] in root.columns : Rectangle {
            width: root.width / root.columns.length;
            height: 100%;
            background: root.drop-column == j ? root.border : root.shadow;
            Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                background: root.face;
                border-width: 2px; border-color: root.drop-column == j ? root.border : root.border;
                VerticalLayout {
                    padding: 4px; spacing: 2px;
                    Rectangle {
                        height: 24px;
                        background: root.header-face;
                        Text { text: col; color: PixelTheme.text; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    for card[k] in root.cards[j] : Rectangle {
                        height: 30px;
                        background: root.border;
                        Rectangle {
                            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                            background: root.face;
                            Text { text: card; color: PixelTheme.text; font-size: 11px; vertical-alignment: center; }
                        }
                        card-ta := TouchArea {
                            pointer-event(ev) => {
                                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                                    root.drag-column = j;
                                    root.drag-card = k;
                                    root.drop-column = j;
                                    root.drag-start(j, k);
                                } else if ev.kind == PointerEventKind.move && root.drag-column >= 0 {
                                    root.drop-column = Math.min(root.columns.length - 1, Math.max(0, Math.floor(self.mouse-x / Math.max(root.width / root.columns.length, 1px))));
                                    root.drag-over(root.drop-column);
                                } else if ev.kind == PointerEventKind.up && root.drag-column >= 0 {
                                    root.drop(root.drag-column, root.drag-card, root.drop-column);
                                    root.drag-column = -1;
                                    root.drag-card = -1;
                                }
                            }
                            clicked => { root.card-clicked(j, k); }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }
}

// ===== 命令面板 Pro =====
export component PixelCommandPalettePro inherits Rectangle {
    in property <[string]> groups: [];
    in property <[string]> commands: [];
    in property <[int]> group-index: [];
    in-out property <string> query: "";
    in-out property <bool> open: false;
    in property <color> face: PixelTheme.bg;
    in property <color> face-hover: PixelTheme.hover;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    callback selected(index: int);
    width: 0px;
    height: 0px;

    init => {
        if root.open { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px; y: 0px;
        width: 360px;
        height: 240px;
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%; height: 100%;
            background: root.shadow;
            Rectangle {
                x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
                background: root.face;
                border-width: 2px; border-color: root.border;
                VerticalLayout {
                    padding: 6px; spacing: 4px;
                    Rectangle {
                        height: 28px;
                        TextInput {
                            text <=> root.query;
                            width: 100%; height: 100%;
                            single-line: true;
                            vertical-alignment: center;
                        }
                        Text {
                            visible: root.query == "";
                            x: 6px; width: parent.width - 12px; height: parent.height;
                            text: "输入命令...";
                            color: PixelTheme.dim;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    for cmd[i] in root.commands : Rectangle {
                        height: 28px;
                        background: cmd-ta.has-hover ? root.face-hover : transparent;
                        Text {
                            x: 8px; width: parent.width - 70px; height: parent.height;
                            text: cmd;
                            color: PixelTheme.text;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            x: parent.width - 60px; width: 56px; height: parent.height;
                            text: root.groups.length > root.group-index[i] ? root.groups[root.group-index[i]] : "";
                            color: PixelTheme.dim;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        cmd-ta := TouchArea {
                            clicked => {
                                root.open = false;
                                root.selected(i);
                                popup.close();
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }
}

// ===== 取色器 Pro =====
export component PixelColorPickerPro inherits Rectangle {
    in-out property <color> value: #ff004d;
    in-out property <string> hex: "#ff004d";
    in property <[string]> recent: [];
    in property <color> shadow: PixelTheme.shadow;
    callback changed(color: color);
    callback hex-changed(hex: string);
    callback add-recent(hex: string);
    width: 220px;
    height: 96px;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
            background: #ffffff;
            border-width: 2px;
            border-color: root.shadow;
            VerticalLayout {
                padding: 6px; spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 40px; height: 40px;
                        background: root.shadow;
                        Rectangle { x: 2px; y: 2px; width: 36px; height: 36px; background: root.value; }
                    }
                    PixelTextInput {
                        text <=> root.hex;
                        height: 32px;
                        edited => { root.hex-changed(root.hex); }
                    }
                }
                PixelColorPicker {
                    palette: [#ff004d, #ffa500, #ffe14d, #00c853, #00bcd4, #2979ff];
                    value: root.value;
                    changed(c) => {
                        root.value = c;
                        root.changed(root.value);
                    }
                }
            }
        }
    }
}

// ===== 提及输入 =====
export component PixelMention inherits Rectangle {
    in property <[string]> options: [];
    in-out property <string> query: "";
    in-out property <bool> open: false;
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    callback selected(value: string);
    height: 32px;
    width: 240px;

    Rectangle {
        width: 100%; height: root.height;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            TextInput {
                x: 6px; width: parent.width - 12px; height: parent.height;
                text <=> root.query;
                single-line: true;
                vertical-alignment: center;
                accepted => { root.open = !root.open; if root.open { popup.show(); } else { popup.close(); } }
            }
        }
    }

    popup := PopupWindow {
        x: 0px; y: root.height + 2px;
        width: 180px;
        height: root.options.length * 28px + 10px;
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%; height: 100%;
            background: root.shadow;
            Rectangle {
                x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
                background: root.face;
                border-width: 2px; border-color: root.border;
                VerticalLayout {
                    for opt in root.options : Rectangle {
                        height: 28px;
                        Text { text: "@" + opt; color: PixelTheme.text; font-size: 12px; vertical-alignment: center; }
                        mta := TouchArea {
                            clicked => {
                                root.query = "@" + opt;
                                root.open = false;
                                root.selected(root.query);
                                popup.close();
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }
}

// ===== OTP 验证码输入 =====
export component PixelOTPInput inherits Rectangle {
    in-out property <string> value: "";
    in property <int> length: 4;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    callback changed(value: string);
    height: 48px;
    width: root.length * 44px;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: 100%; height: 100%;
        TextInput {
            text <=> root.value;
            visible: false;
            width: 1px; height: 1px;
            edited => { root.changed(root.value); }
        }
        HorizontalLayout {
            spacing: 6px;
            for idx in root.length : Rectangle {
                width: 40px; height: 48px;
                background: root.shadow;
                Rectangle {
                    x: 1px; y: 1px; width: 38px; height: 46px;
                    background: root.face;
                    border-width: 2px; border-color: root.border;
                    Text {
                        text: idx == 0 ? root.value : "";
                        color: PixelTheme.text;
                        font-size: 18px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                otp-ta := TouchArea {
                    clicked => { root.changed(root.value); }
                    mouse-cursor: pointer;
                }
            }
        }
    }
}

// ===== 手写签名 =====
export component PixelSignature inherits Rectangle {
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> ink: PixelTheme.text;
    callback begin(x: length, y: length);
    callback move(x: length, y: length);
    callback end;
    callback clear;
    height: 120px;
    width: 260px;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            sig-ta := TouchArea {
                pointer-event(ev) => {
                    if ev.button != PointerEventButton.left { return; }
                    if ev.kind == PointerEventKind.down {
                        root.begin(self.mouse-x, self.mouse-y);
                    } else if ev.kind == PointerEventKind.move {
                        root.move(self.mouse-x, self.mouse-y);
                    } else if ev.kind == PointerEventKind.up {
                        root.end();
                    }
                }
                mouse-cursor: crosshair;
            }
            PixelButton {
                x: parent.width - 40px; y: 4px; width: 34px; height: 24px;
                text: "清空";
                clicked => { root.clear(); }
            }
        }
    }
}

// ===== 抽屉 Pro =====
export component PixelDrawerPro inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <length> drawer-width: 240px;
    in property <string> title: "";
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    callback close;
    width: 100%;
    height: 100%;

    // 遮罩
    Rectangle {
        visible: root.open;
        width: 100%; height: 100%;
        background: #00000080;
        TouchArea { clicked => { root.open = false; root.close(); } }
    }
    // 抽屉面板
    Rectangle {
        x: root.open ? parent.width - root.drawer-width : parent.width;
        width: root.drawer-width;
        height: 100%;
        background: root.shadow;
        animate x { duration: 160ms; easing: ease-out; }
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            VerticalLayout {
                padding: 6px; spacing: 6px;
                Text {
                    text: root.title;
                    color: PixelTheme.text;
                    font-weight: 700;
                    font-size: 14px;
                }
                @children
                PixelButton {
                    text: "关闭";
                    clicked => { root.open = false; root.close(); }
                }
            }
        }
    }
}
