import { PixelTheme } from "pixel_theme.slint";
import { PixelButton } from "pixel_painter_widget.slint";
import { ScrollView } from "std-widgets.slint";

// ============================================================================
// slint-pixel · 高级组件 P0：数据可视化 / 专业表格 / 校验 / 排期
// ============================================================================

// ===== 柱状图 =====
export component PixelChart inherits Rectangle {
    in property <[float]> data: [];
    in property <[string]> labels: [];
    in property <color> bar: PixelTheme.accent;
    in property <color> grid: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    callback bar-clicked(index: int);
    height: 120px;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
            background: #ffffff;
            border-width: 2px; border-color: root.grid;
            HorizontalLayout {
                padding: 8px;
                spacing: 4px;
                for d[i] in root.data : Rectangle {
                    width: (parent.width - 16px) / root.data.length;
                    vertical-stretch: 1;
                    Rectangle {
                        width: 100%;
                        height: Math.max(2px, 90px * Math.min(root.data[i], 100.0) / 100.0);
                        background: root.bar;
                        TouchArea {
                            clicked => { root.bar-clicked(i); }
                            mouse-cursor: pointer;
                        }
                    }
                    Text {
                        visible: root.labels.length > i;
                        width: 100%; height: 12px;
                        text: root.labels[i];
                        color: root.text-color;
                        font-size: 9px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// ===== 迷你趋势图 =====
export component PixelSparkline inherits Rectangle {
    in property <[float]> data: [];
    in property <color> bar: PixelTheme.accent;
    in property <color> shadow: PixelTheme.shadow;
    height: 30px;
    width: 120px;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        HorizontalLayout {
            padding: 2px;
            spacing: 2px;
            for d in root.data : Rectangle {
                width: (parent.width - 4px) / Math.max(root.data.length, 1);
                vertical-stretch: 1;
                Rectangle {
                    width: 100%;
                    height: Math.max(2px, 22px * Math.min(d, 100.0) / 100.0);
                    background: root.bar;
                }
            }
        }
    }
}

// ===== 专业数据表格 =====
export component PixelDataGrid inherits Rectangle {
    in property <[string]> headers: [];
    in property <[[string]]> rows: [];
    in-out property <int> selected-row: -1;
    in-out property <int> sort-column: -1;
    in-out property <[length]> column-widths: [];
    in property <bool> enabled: true;
    in property <length> header-height: 28px;
    in property <length> row-height: 26px;
    in property <length> viewport-height: 160px;
    in property <color> face: PixelTheme.bg;
    in property <color> header-face: PixelTheme.panel;
    in property <color> row-even: PixelTheme.bg;
    in property <color> row-odd: PixelTheme.bg;
    in property <color> row-selected: PixelTheme.accent;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> dim: PixelTheme.dim;
    callback row-clicked(row: int);
    callback sort-requested(column: int);
    callback column-resize(column: int, width: length);
    height: root.viewport-height;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            clip: true;
            Rectangle {
                height: root.header-height;
                background: root.header-face;
                HorizontalLayout {
                    for h[j] in root.headers : Rectangle {
                        width: root.column-widths.length > j ? root.column-widths[j] : (parent.width / root.headers.length);
                        background: header-ta.has-hover ? root.row-odd : transparent;
                        Text {
                            text: h + (root.sort-column == j ? " ↕" : "");
                            color: root.dim;
                            font-weight: 700;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        header-ta := TouchArea {
                            clicked => {
                                root.sort-column = j;
                                root.sort-requested(j);
                            }
                            mouse-cursor: pointer;
                        }
                        Rectangle {
                            visible: j < root.headers.length - 1;
                            x: parent.width - 4px;
                            width: 4px; height: 100%;
                            background: resize-ta.has-hover ? root.border : transparent;
                            resize-ta := TouchArea {
                                pointer-event(ev) => {
                                    if ev.kind == PointerEventKind.move || ev.kind == PointerEventKind.down {
                                        if ev.button == PointerEventButton.left {
                                            root.column-resize(j, self.mouse-x);
                                        }
                                    }
                                }
                                mouse-cursor: ew-resize;
                            }
                        }
                    }
                }
            }
            ScrollView {
                x: 0px; y: root.header-height;
                width: parent.width; height: parent.height - root.header-height;
                VerticalLayout {
                    for r[i] in root.rows : Rectangle {
                        height: root.row-height;
                        background: root.selected-row == i ? root.row-selected
                            : (Math.mod(i, 2) == 0 ? root.row-even : root.row-odd);
                        HorizontalLayout {
                            for cell in r : Text {
                                text: cell;
                                color: root.selected-row == i ? #ffffff : root.text-color;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        row-ta := TouchArea {
                            clicked => {
                                root.selected-row = i;
                                root.row-clicked(i);
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }
}

// ===== 专业表格 Pro（继承 DataGrid） =====
export component PixelProTable inherits PixelDataGrid {
}

// ===== 虚拟滚动列表 =====
export component PixelVirtualScroll inherits Rectangle {
    in property <[string]> items: [];
    in-out property <int> selected: -1;
    in property <length> row-height: 28px;
    in property <length> viewport-height: 140px;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> face-hover: PixelTheme.hover;
    in property <color> face-selected: PixelTheme.accent;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    callback item-selected(index: int);
    height: root.viewport-height;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            clip: true;
            ScrollView {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                VerticalLayout {
                    for item[i] in root.items : Rectangle {
                        height: root.row-height;
                        background: root.selected == i ? root.face-selected
                            : (virt-ta.has-hover ? root.face-hover : transparent);
                        Text {
                            x: 10px; width: parent.width - 20px; height: parent.height;
                            text: item;
                            color: root.selected == i ? #ffffff : root.text-color;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        virt-ta := TouchArea {
                            enabled: root.enabled;
                            clicked => {
                                root.selected = i;
                                root.item-selected(i);
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }
}

// ===== 树（Pro：levels + expanded 受控） =====
export component PixelTreePro inherits Rectangle {
    in property <[string]> items: [];
    in property <[int]> levels: [];
    in property <[bool]> expanded: [];
    in-out property <int> selected: -1;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> face-hover: PixelTheme.hover;
    in property <color> face-selected: PixelTheme.accent;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    callback item-selected(index: int);
    callback toggle(index: int);
    preferred-height: root.items.length * 28px + 4px;
    min-height: root.items.length * 28px + 4px;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            clip: true;
            VerticalLayout {
                padding: 1px; spacing: 0px;
                for item[i] in root.items : Rectangle {
                    height: 28px;
                    background: root.selected == i ? root.face-selected
                        : (tree-ta.has-hover ? root.face-hover : transparent);
                    Text {
                        x: 10px + root.levels[i] * 18px;
                        width: parent.width - 30px - root.levels[i] * 18px;
                        height: parent.height;
                        text: item;
                        color: root.selected == i ? #ffffff : root.text-color;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        x: root.levels[i] * 18px;
                        width: 18px; height: parent.height;
                        text: root.expanded.length > i && root.expanded[i] ? "▼" : "▶";
                        color: root.text-color;
                        font-size: 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    tree-ta := TouchArea {
                        enabled: root.enabled;
                        clicked => {
                            root.selected = i;
                            root.item-selected(i);
                            root.toggle(i);
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}

// ===== 表单校验器 =====
export component PixelFormValidator inherits Rectangle {
    in property <[string]> fields: [];
    in property <[bool]> valid: [];
    in property <[string]> errors: [];
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> danger: PixelTheme.danger;
    callback submit;
    preferred-height: root.fields.length * 32px + 8px;
    min-height: root.fields.length * 32px + 8px;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            VerticalLayout {
                padding: 4px; spacing: 0px;
                for f[i] in root.fields : Rectangle {
                    height: 32px;
                    Text {
                        x: 8px; width: 100px; height: parent.height;
                        text: f;
                        color: root.text-color;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 116px; width: parent.width - 200px; height: parent.height;
                        text: root.valid.length > i && root.valid[i] ? "✓" : (root.errors.length > i ? root.errors[i] : "");
                        color: root.valid.length > i && root.valid[i] ? root.border : root.danger;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                PixelButton {
                    text: "提交";
                    clicked => { root.submit(); }
                }
            }
        }
    }
}

// ===== 排期器 =====
export component PixelScheduler inherits Rectangle {
    in property <[string]> times: ["09:00", "10:00", "11:00"];
    in property <[string]> events: [];
    in-out property <int> active: -1;
    in property <color> face: PixelTheme.bg;
    in property <color> face-hover: PixelTheme.hover;
    in property <color> face-active: PixelTheme.accent;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    callback event-clicked(index: int);
    preferred-height: root.times.length * 34px + 4px;
    min-height: root.times.length * 34px + 4px;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            VerticalLayout {
                padding: 2px; spacing: 0px;
                for t[i] in root.times : Rectangle {
                    height: 34px;
                    background: root.active == i ? root.face-active
                        : (sched-ta.has-hover ? root.face-hover : transparent);
                    Text {
                        x: 8px; width: 60px; height: parent.height;
                        text: t;
                        color: root.active == i ? #ffffff : root.text-color;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 76px; width: parent.width - 84px; height: parent.height;
                        text: root.events.length > i ? root.events[i] : "空闲";
                        color: root.active == i ? #ffffff : PixelTheme.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    sched-ta := TouchArea {
                        clicked => {
                            root.active = i;
                            root.event-clicked(i);
                        }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}

// ===== 日历议程 =====
export component PixelCalendarAgenda inherits Rectangle {
    in property <[string]> dates: [];
    in property <[string]> events: [];
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> dim: PixelTheme.dim;
    preferred-height: root.dates.length * 34px + 4px;
    min-height: root.dates.length * 34px + 4px;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            VerticalLayout {
                padding: 2px; spacing: 0px;
                for d[i] in root.dates : Rectangle {
                    height: 34px;
                    Text {
                        x: 8px; width: 90px; height: parent.height;
                        text: d;
                        color: root.text-color;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 106px; width: parent.width - 114px; height: parent.height;
                        text: root.events.length > i ? root.events[i] : "";
                        color: root.dim;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
