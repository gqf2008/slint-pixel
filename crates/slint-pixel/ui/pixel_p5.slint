import { PixelTheme } from "pixel_theme.slint";
import { PixelButton } from "pixel_painter_widget.slint";
import { PixelTextArea } from "pixel_extra.slint";
import { PixelDatePicker } from "pixel_p2.slint";

// ============================================================================
// slint-pixel · 第二轮补齐：富文本/代码/图片裁切/二维码/水印/日历
// ============================================================================

// ===== 富文本编辑器 =====
export component PixelRichTextEditor inherits Rectangle {
    in-out property <string> value: "";
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    callback bold;
    callback italic;
    callback underline;
    callback link;
    height: 160px;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            VerticalLayout {
                padding: 4px; spacing: 4px;
                HorizontalLayout {
                    spacing: 4px;
                    PixelButton { text: "B"; width: 26px; clicked => { root.bold(); } }
                    PixelButton { text: "I"; width: 26px; clicked => { root.italic(); } }
                    PixelButton { text: "U"; width: 26px; clicked => { root.underline(); } }
                    PixelButton { text: "🔗"; width: 34px; clicked => { root.link(); } }
                }
                PixelTextArea {
                    text <=> root.value;
                    height: 110px;
                    enabled: root.enabled;
                }
            }
        }
    }
}

// ===== 代码块 =====
export component PixelCodeBlock inherits Rectangle {
    in property <string> code: "";
    in property <string> language: "";
    in property <color> face: #1a1a1a;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: #ffffff;
    callback copy;
    height: 120px;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            Text {
                x: 8px; y: 4px; width: parent.width - 16px; height: parent.height - 8px;
                text: root.code;
                color: root.text-color;
                font-family: "monospace";
                font-size: 12px;
                wrap: word-wrap;
            }
            PixelButton {
                x: parent.width - 40px; y: 4px; width: 32px; height: 24px;
                text: "复制";
                clicked => { root.copy(); }
            }
        }
    }
}

// ===== 图片裁切 =====
export component PixelImageCrop inherits Rectangle {
    in property <image> source;
    in property <length> crop-size: 80px;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    callback crop;
    width: 200px;
    height: 160px;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
            background: #ffffff;
            border-width: 2px; border-color: root.border;
            clip: true;
            Image {
                source: root.source;
                image-rendering: pixelated;
                width: 100%; height: 100%;
            }
            // 裁切框
            Rectangle {
                x: (parent.width - root.crop-size) / 2;
                y: (parent.height - root.crop-size) / 2;
                width: root.crop-size; height: root.crop-size;
                background: transparent;
                border-width: 2px;
                border-color: root.border;
            }
        }
        PixelButton {
            x: parent.width - 36px; y: parent.height - 26px; width: 32px; height: 22px;
            text: "裁剪";
            clicked => { root.crop(); }
        }
    }
}

// ===== 二维码 =====
export component PixelQRCode inherits Rectangle {
    in property <string> code: "slint-pixel";
    in property <color> dark: #000000;
    in property <color> light: #ffffff;
    width: 126px;
    height: 126px;

    VerticalLayout {
        spacing: 0px;
        for row in 21 : HorizontalLayout {
            spacing: 0px;
            for col in 21 : Rectangle {
                width: 6px; height: 6px;
                background: Math.mod(row * 31 + col * 17 + (root.code == "" ? 0 : 1), 5) < 2 ? root.dark : root.light;
            }
        }
    }
}

// ===== 水印 =====
export component PixelWatermark inherits Rectangle {
    in property <string> text: "SLINT PIXEL";
    in property <color> watermark-color: PixelTheme.dim;
    in property <color> face: PixelTheme.bg;
    @children
    Text {
        text: root.text;
        color: root.watermark-color;
        opacity: 0.4;
        font-size: 24px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ===== 日历 =====
export component PixelCalendar inherits Rectangle {
    in-out property <int> year: 2026;
    in-out property <int> month: 1;
    in-out property <int> day: 1;
    in property <[string]> events: [];
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> dim: PixelTheme.dim;
    callback date-changed(year: int, month: int, day: int);
    width: 250px;
    height: 300px;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            VerticalLayout {
                padding: 4px; spacing: 4px;
                PixelDatePicker {
                    year: root.year; month: root.month; day: root.day;
                    width: 100%; height: 220px;
                    changed(y, m, d) => {
                        root.year = y; root.month = m; root.day = d;
                        root.date-changed(root.year, root.month, root.day);
                    }
                }
                Text {
                    text: root.events.length > 0 ? root.events[0] : "当天无日程";
                    color: root.events.length > 0 ? root.text-color : root.dim;
                    font-size: 12px;
                }
            }
        }
    }
}
