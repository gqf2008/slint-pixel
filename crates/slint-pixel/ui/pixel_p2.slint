import { PixelTheme } from "pixel_theme.slint";
import { PixelButton } from "pixel_painter_widget.slint";
import { PixelNumberInput } from "pixel_more.slint";

// ============================================================================
// slint-pixel · 日历/时间/命令面板/看板/引导组件
//
// 组件清单：
//   PixelDatePicker      月历选择器（年/月/日由宿主传入）
//   PixelTimePicker      时分选择器
//   PixelCommandPalette  命令面板（搜索框 + 选项列表）
//   PixelKanban          看板（数据驱动列与卡片）
//   PixelOnboarding      分步引导
// ============================================================================

// ===== 月历选择器 =====
export component PixelDatePicker inherits Rectangle {
    in-out property <int> year: 2026;
    in-out property <int> month: 1;
    in-out property <int> day: 1;
    in property <int> first-weekday: 0; // 0=周日, 1=周一 ...
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> face-hover: PixelTheme.hover;
    in property <color> face-selected: PixelTheme.accent;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> dim: PixelTheme.dim;
    callback changed(year: int, month: int, day: int);
    width: 250px;
    height: 220px;
    opacity: root.enabled ? 1.0 : 0.5;

    property <int> days-count: root.days-in-month(root.year, root.month);

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            VerticalLayout {
                padding: 4px; spacing: 2px;
                // 月份切换
                HorizontalLayout {
                    PixelButton { text: "‹"; width: 24px; height: 24px; clicked => { root.prev-month(); } }
                    Text {
                        text: root.year + " 年 " + root.month + " 月";
                        color: root.text-color;
                        font-weight: 700; font-size: 13px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    PixelButton { text: "›"; width: 24px; height: 24px; clicked => { root.next-month(); } }
                }
                // 星期表头
                HorizontalLayout {
                    for wd in ["日","一","二","三","四","五","六"] : Text {
                        text: wd;
                        color: root.dim;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
                // 日期网格
                VerticalLayout {
                    spacing: 2px;
                    for week in 6 : HorizontalLayout {
                        spacing: 2px;
                        for col in 7 : cell := Rectangle {
                            property <int> d: week * 7 + col - root.first-weekday + 1;
                            background: root.day == cell.d ? root.face-selected
                                : (date-ta.has-hover ? root.face-hover : transparent);
                            Text {
                                visible: cell.d >= 1 && cell.d <= root.days-count;
                                text: cell.d;
                                color: root.day == cell.d ? #ffffff : root.text-color;
                                font-size: 12px;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            date-ta := TouchArea {
                                enabled: root.enabled && cell.d >= 1 && cell.d <= root.days-count;
                                clicked => {
                                    root.day = cell.d;
                                    root.changed(root.year, root.month, root.day);
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
            }
        }
    }

    function days-in-month(y: int, m: int) -> int {
        if m == 2 {
            return Math.mod(y, 4) == 0 && (Math.mod(y, 100) != 0 || Math.mod(y, 400) == 0) ? 29 : 28;
        }
        if m == 4 || m == 6 || m == 9 || m == 11 {
            return 30;
        }
        return 31;
    }

    function prev-month() {
        root.month = root.month - 1;
        if root.month < 1 {
            root.month = 12;
            root.year = root.year - 1;
        }
        root.day = 1;
        root.changed(root.year, root.month, root.day);
    }
    function next-month() {
        root.month = root.month + 1;
        if root.month > 12 {
            root.month = 1;
            root.year = root.year + 1;
        }
        root.day = 1;
        root.changed(root.year, root.month, root.day);
    }
}

// ===== 时分选择器 =====
export component PixelTimePicker inherits Rectangle {
    in-out property <int> hour: 9;
    in-out property <int> minute: 30;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    callback changed(hour: int, minute: int);
    height: 36px;
    width: 180px;
    opacity: root.enabled ? 1.0 : 0.5;

    HorizontalLayout {
        spacing: 4px;
        PixelNumberInput {
            value: root.hour;
            min: 0; max: 23; step: 1;
            width: 70px;
            changed(v) => {
                root.hour = v;
                root.changed(root.hour, root.minute);
            }
        }
        Text { text: ":"; color: root.text-color; font-weight: 700; vertical-alignment: center; }
        PixelNumberInput {
            value: root.minute;
            min: 0; max: 59; step: 1;
            width: 70px;
            changed(v) => {
                root.minute = v;
                root.changed(root.hour, root.minute);
            }
        }
    }
}

// ===== 命令面板 =====
export component PixelCommandPalette inherits Rectangle {
    in property <[string]> items: [];
    in-out property <string> query: "";
    in-out property <bool> open: false;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> face-hover: PixelTheme.hover;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> dim: PixelTheme.dim;
    callback selected(index: int);
    width: 0px;
    height: 0px;
    opacity: root.enabled ? 1.0 : 0.5;

    init => {
        if root.open { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px; y: 0px;
        width: 320px;
        height: 220px;
        close-policy: close-on-click-outside;
        Rectangle {
            width: 100%; height: 100%;
            background: root.shadow;
            Rectangle {
                x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
                background: root.face;
                border-width: 2px; border-color: root.border;
                VerticalLayout {
                    padding: 6px; spacing: 4px;
                    Rectangle {
                        height: 28px;
                        TextInput {
                            text <=> root.query;
                            width: 100%; height: 100%;
                        }
                        Text {
                            visible: root.query == "";
                            x: 6px; width: parent.width - 12px; height: parent.height;
                            text: "输入命令...";
                            color: root.dim;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle {
                        height: root.items.length * 30px + 4px;
                        VerticalLayout {
                            for item[i] in root.items : Rectangle {
                                height: 30px;
                                background: cmd-ta.has-hover ? root.face-hover : transparent;
                                Text {
                                    text: item;
                                    color: root.text-color;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                                cmd-ta := TouchArea {
                                    clicked => {
                                        root.open = false;
                                        root.selected(i);
                                        popup.close();
                                    }
                                    mouse-cursor: pointer;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ===== 看板 =====
export component PixelKanban inherits Rectangle {
    in property <[string]> columns: [];
    in property <[[string]]> cards: [];
    in-out property <int> active-column: 0;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> header-face: PixelTheme.panel;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    callback card-clicked(column: int, card: int);
    height: 200px;
    opacity: root.enabled ? 1.0 : 0.5;

    HorizontalLayout {
        spacing: 6px;
        for col[j] in root.columns : Rectangle {
            width: root.width / root.columns.length;
            height: 100%;
            background: root.shadow;
            Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                background: root.face;
                border-width: 2px; border-color: root.border;
                VerticalLayout {
                    padding: 4px; spacing: 2px;
                    Rectangle {
                        height: 24px;
                        background: root.header-face;
                        Text {
                            text: col;
                            color: root.text-color;
                            font-weight: 700; font-size: 12px;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    for card[k] in root.cards[j] : Rectangle {
                        height: 28px;
                        background: root.border;
                        Rectangle {
                            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                            background: root.face;
                            Text {
                                text: card;
                                color: root.text-color;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                        card-ta := TouchArea {
                            clicked => {
                                root.active-column = j;
                                root.card-clicked(j, k);
                            }
                            mouse-cursor: pointer;
                        }
                    }
                }
            }
        }
    }
}

// ===== 分步引导 =====
export component PixelOnboarding inherits Rectangle {
    in property <[string]> titles: [];
    in property <[string]> descriptions: [];
    in-out property <int> current: 0;
    in property <bool> enabled: true;
    in property <color> face: PixelTheme.bg;
    in property <color> border: PixelTheme.edge;
    in property <color> shadow: PixelTheme.shadow;
    in property <color> text-color: PixelTheme.text;
    in property <color> dim: PixelTheme.dim;
    callback finished;
    callback step-changed(index: int);
    width: 300px;
    height: 160px;
    opacity: root.enabled ? 1.0 : 0.5;

    property <bool> has-prev: root.current > 0;
    property <bool> has-next: root.current < root.titles.length - 1;

    Rectangle {
        width: 100%; height: 100%;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px; border-color: root.border;
            VerticalLayout {
                padding: 10px; spacing: 6px;
                Text {
                    text: root.titles.length > 0 ? root.titles[root.current] : "";
                    color: root.text-color;
                    font-weight: 700; font-size: 14px;
                }
                Text {
                    text: root.descriptions.length > 0 ? root.descriptions[root.current] : "";
                    color: root.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    PixelButton {
                        text: "上一步";
                        width: 60px;
                        clicked => {
                            root.current = Math.max(0, root.current - 1);
                            root.step-changed(root.current);
                        }
                    }
                    PixelButton {
                        text: root.has-next ? "下一步" : "完成";
                        width: 60px;
                        clicked => {
                            if root.has-next {
                                root.current = root.current + 1;
                                root.step-changed(root.current);
                            } else {
                                root.finished();
                            }
                        }
                    }
                }
            }
        }
    }
}
