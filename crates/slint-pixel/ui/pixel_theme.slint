// ============================================================================
// slint-pixel · 全局主题（所有组件默认色引用此 global，改一处全部生效）
// 宿主可在 .slint 里覆盖：PixelTheme.bg = #...; 或在 Rust 侧用 slint::global!()。
// ============================================================================
export global PixelTheme {
    in property <color> bg: #ffffff;      // 背景 / 页面 / 输入面 / 内容区
    in property <color> panel: #ffffff;   // 面板 / 轨道 / 表头
    in property <color> hover: #f2f2f2;   // 悬停 / 按钮面 / 浅灰
    in property <color> edge: #1a1a1a;    // 边框 / 分隔线
    in property <color> shadow: #000000;  // 阴影 / 深色块
    in property <color> text: #000000;    // 主文字 / 图标
    in property <color> dim: #525252;     // 次要文字
    in property <color> accent: #000000;  // 强调 / 激活 / 选中底色
    in property <color> danger: #ff004d;  // 危险
}