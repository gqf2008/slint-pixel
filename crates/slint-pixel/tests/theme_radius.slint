// 圆角主题的行为探针（只给 tests/theme_radius.rs 用，不进组件清单）。
//
// 红底上摆三块被测面，左上角那几颗像素在「直角 / 圆角」两种设置下必须不同：
//   - 直角：左上角是面自己的描边（Panel）/ 硬阴影层（Card、Badge）
//   - 圆角：左上角被切掉，露出红底
// 这样断言就落在「圆角真的生效」这件行为上，而不是「属性赋值成功」。
import { PixelPanel, PixelCard, PixelBadge, PixelTheme, PixelWindowBody } from "@slint_pixel";

export component RadiusProbe inherits Window {
    width: 200px;
    height: 80px;
    background: #ff0000;

    // 测试从 Rust 侧改这个值，再由它写进 PixelTheme —— 组件必须真的读主题才会变。
    // 只写 radius：PixelBadge 走的是 radius-sm，它必须能从默认绑定（radius / 2）自动派生，
    // 否则"改一个 radius 小件不跟随"这个坑就会被漏掉。
    in-out property <length> probe-radius: 0px;
    changed probe-radius => {
        PixelTheme.radius = root.probe-radius;
    }

    PixelPanel {
        x: 10px; y: 10px; width: 40px; height: 40px;
        title: "";
    }
    PixelCard {
        x: 70px; y: 10px; width: 40px; height: 40px;
        title: "";
    }
    PixelBadge {
        x: 130px; y: 10px;
        width: 40px;
        text: "";
    }
}

// 圆角窗身探针（同文件第二个窗口，测试里各用一个独立的 MinimalSoftwareWindow）：
// 窗口底色红、窗身白 —— window-radius = 0 时四角是窗身白，> 0 时四角露出窗口底色红。
export component WindowBodyProbe inherits Window {
    width: 80px;
    height: 80px;
    background: #ff0000;

    in-out property <length> probe-window-radius: 0px;
    changed probe-window-radius => {
        PixelTheme.window-radius = root.probe-window-radius;
    }

    PixelWindowBody {
        face: #ffffff;
        border: #000000;
    }
}
