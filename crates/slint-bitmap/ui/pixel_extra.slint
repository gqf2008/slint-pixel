// ============================================================================
// slint-bitmap · 表单/反馈/文本类像素风组件（纯 Slint 自绘，跨平台）
//
// 组件清单：
//   PixelText        像素风文本（默认字号/颜色）
//   PixelTitle       像素风标题（大字加粗）
//   PixelFormItem    表单项（左标签 + 右控件插槽）
//   PixelForm        表单容器（表单项列表）
//   PixelTextArea    多行文本输入（换行 + 占位符）
//   PixelIconButton  图标按钮（通用字形图标 + 悬停高亮）
//   PixelTooltip     悬停提示气泡（延迟显示，包裹任意目标）
//   PixelBubble      富内容气泡/弹出卡片（触发图标 + 箭头 + 内容插槽）
//   PixelPopconfirm  操作确认气泡（触发按钮 + 确定/取消）
//
// 角标直接用 PixelBadge（gallery 里演示"图标按钮 + 右上角数字角标"用法）。
// ============================================================================

import { PixelButton } from "pixel_painter_widget.slint";

// ===== 像素风文本 =====
export component PixelText inherits Text {
    font-size: 13px;
}

// ===== 像素风标题 =====
export component PixelTitle inherits Text {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 1px;
}

// ===== 表单项（左标签 + 右控件） =====
export component PixelFormItem inherits Rectangle {
    in property <string> label: "";
    in property <length> label-width: 90px;
    in property <color> label-color: #262626;
    HorizontalLayout {
        spacing: 10px;
        Text {
            width: root.label-width;
            text: root.label;
            color: root.label-color;
            font-size: 13px;
            vertical-alignment: center;
        }
        @children
    }
}

// ===== 表单容器 =====
export component PixelForm inherits Rectangle {
    in property <length> spacing: 12px;
    VerticalLayout {
        spacing: root.spacing;
        @children
    }
}

// ===== 多行文本输入 =====
export component PixelTextArea inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    in property <bool> enabled: true;
    in property <length> frame-height: 96px;
    in property <color> face: #ffffff;
    in property <color> border: #ddd9d2;
    in property <color> border-focus: #1a73e8;
    in property <color> shadow: #48453f;
    in property <color> text-color: #262626;
    in property <color> placeholder-color: #9a968f;
    callback accepted;
    callback edited;
    height: root.frame-height;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: root.width; height: root.height;
        background: root.shadow;
        Rectangle {
            x: 1px; y: 1px;
            width: parent.width - 2px; height: parent.height - 2px;
            background: root.face;
            border-width: 2px;
            border-color: input.has-focus ? root.border-focus : root.border;
            input := TextInput {
                enabled: root.enabled;
                x: 6px; y: 4px;
                width: parent.width - 12px; height: parent.height - 8px;
                text <=> root.text;
                color: root.text-color;
                font-size: 13px;
                single-line: false;
                wrap: word-wrap;
                accepted => { root.accepted(); }
                edited => { root.edited(); }
            }
            // 占位符
            Text {
                visible: root.text == "" && !input.has-focus;
                x: 8px; y: 6px;
                text: root.placeholder;
                color: root.placeholder-color;
                font-size: 13px;
            }
        }
    }
}

// ===== 图标按钮（通用字形，跨平台） =====
export component PixelIconButton inherits Rectangle {
    in property <string> icon: "?";
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <color> face: #f3f2ee;
    in property <color> face-hover: #d9d4ca;
    in property <color> face-active: #29adff;
    in property <color> border: #ddd9d2;
    in property <color> shadow: #48453f;
    in property <color> icon-color: #262626;
    callback clicked;
    width: 34px;
    height: 34px;
    opacity: root.enabled ? 1.0 : 0.5;

    Rectangle {
        width: root.width; height: root.height;
        background: root.shadow;
        Rectangle {
            x: ta.pressed ? 1px : 0px;
            y: ta.pressed ? 1px : 0px;
            width: parent.width - 2px; height: parent.height - 2px;
            background: root.active ? root.face-active : (ta.has-hover ? root.face-hover : root.face);
            border-width: 2px;
            border-color: root.active ? root.face-active : root.border;
            Text {
                text: root.icon;
                color: root.active ? #ffffff : root.icon-color;
                font-weight: 700;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ta := TouchArea {
                enabled: root.enabled;
                clicked => { root.clicked(); }
                mouse-cursor: pointer;
            }
        }
    }
}

// ===== 悬停提示气泡（包裹任意目标，延迟显示） =====
export component PixelTooltip inherits Rectangle {
    in property <string> text: "";
    in property <duration> delay: 400ms;
    in-out property <bool> open: false;
    in property <color> bubble-bg: #262626;
    in property <color> bubble-border: #000000;
    in property <color> text-color: #ffffff;
    in property <color> arrow: #262626;

    // 悬停轮询：悬停/外部 open 则显示，离开则关闭
    property <bool> hovered: ta.has-hover;
    Timer {
        interval: root.delay;
        running: root.hovered || root.open || popup.is-open;
        triggered => {
            if root.hovered || root.open {
                popup.show();
            } else {
                popup.close();
            }
        }
    }

    // 悬停热区（内容在上层，不挡点击）
    ta := TouchArea {
        width: 100%; height: 100%;
    }
    @children

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        close-policy: no-auto-close;
        Rectangle {
            background: root.bubble-border;
            Rectangle {
                x: 2px; y: 2px;
                width: parent.width - 4px; height: parent.height - 4px;
                background: root.bubble-bg;
                border-width: 2px;
                border-color: root.bubble-border;
                // 箭头（向上小三角）
                Rectangle {
                    x: 12px; y: -6px; width: 8px; height: 4px;
                    background: root.arrow;
                }
                Text {
                    x: 8px; y: 6px;
                    width: parent.width - 16px;
                    text: root.text;
                    color: root.text-color;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// ===== 富内容气泡 / 弹出卡片（触发图标 + 箭头 + 内容插槽） =====
export component PixelBubble inherits Rectangle {
    in property <string> icon: "?";
    in-out property <bool> open: false;
    in property <string> title: "";
    in property <color> face: #f3f2ee;
    in property <color> face-hover: #d9d4ca;
    in property <color> border: #ddd9d2;
    in property <color> shadow: #48453f;
    in property <color> icon-color: #262626;
    in property <color> bubble-bg: #ffffff;
    in property <color> bubble-edge: #ddd9d2;
    in property <color> bubble-shadow: #48453f;
    in property <color> title-color: #262626;
    callback closed;
    width: 34px;
    height: 34px;

    init => {
        if root.open {
            popup.show();
        }
    }

    // 触发按钮（图标）
    Rectangle {
        width: root.width; height: root.height;
        background: root.shadow;
        Rectangle {
            x: ta.pressed ? 1px : 0px;
            y: ta.pressed ? 1px : 0px;
            width: parent.width - 2px; height: parent.height - 2px;
            background: ta.has-hover ? root.face-hover : root.face;
            border-width: 2px;
            border-color: root.border;
            Text {
                text: root.icon;
                color: root.icon-color;
                font-weight: 700;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ta := TouchArea {
                clicked => {
                    root.open = !root.open;
                    if root.open {
                        popup.show();
                    } else {
                        popup.close();
                    }
                }
                mouse-cursor: pointer;
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: 280px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: root.bubble-shadow;
            Rectangle {
                x: 3px; y: 3px;
                width: parent.width - 6px; height: parent.height - 6px;
                background: root.bubble-bg;
                border-width: 2px;
                border-color: root.bubble-edge;
                // 箭头（向上小三角）
                Rectangle {
                    x: 12px; y: -7px; width: 10px; height: 5px;
                    background: root.bubble-bg;
                    Rectangle {
                        x: 1px; y: 0px; width: 8px; height: 3px;
                        background: root.bubble-edge;
                    }
                }
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Text {
                        text: root.title;
                        color: root.title-color;
                        font-weight: 800;
                        font-size: 13px;
                    }
                    Rectangle { height: 2px; background: root.bubble-edge; }
                    @children
                }
            }
        }
    }
}

// ===== 操作确认气泡（触发按钮 + 确定/取消） =====
export component PixelPopconfirm inherits Rectangle {
    in property <string> text: "确定执行此操作？";
    in property <string> button-text: "删除";
    in property <string> confirm-text: "确定";
    in property <string> cancel-text: "取消";
    in-out property <bool> open: false;
    in property <bool> enabled: true;
    in property <color> face: #f3f2ee;
    in property <color> face-hover: #d9d4ca;
    in property <color> danger: #ff004d;
    in property <color> border: #ddd9d2;
    in property <color> shadow: #48453f;
    in property <color> text-color: #262626;
    in property <color> bubble-bg: #ffffff;
    in property <color> bubble-edge: #ddd9d2;
    in property <color> bubble-shadow: #48453f;
    callback confirm;
    callback cancel;
    width: 96px;
    height: 32px;
    opacity: root.enabled ? 1.0 : 0.5;

    init => {
        if root.open {
            popup.show();
        }
    }

    // 触发按钮
    Rectangle {
        width: root.width; height: root.height;
        background: root.shadow;
        Rectangle {
            x: ta.pressed ? 1px : 0px;
            y: ta.pressed ? 1px : 0px;
            width: parent.width - 2px; height: parent.height - 2px;
            background: ta.has-hover ? root.face-hover : root.face;
            border-width: 2px;
            border-color: root.border;
            Text {
                text: root.button-text;
                color: root.text-color;
                font-weight: 700;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ta := TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.open = !root.open;
                    if root.open {
                        popup.show();
                    } else {
                        popup.close();
                    }
                }
                mouse-cursor: pointer;
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: 240px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: root.bubble-shadow;
            Rectangle {
                x: 3px; y: 3px;
                width: parent.width - 6px; height: parent.height - 6px;
                background: root.bubble-bg;
                border-width: 2px;
                border-color: root.bubble-edge;
                // 箭头
                Rectangle {
                    x: 12px; y: -7px; width: 10px; height: 5px;
                    background: root.bubble-bg;
                    Rectangle {
                        x: 1px; y: 0px; width: 8px; height: 3px;
                        background: root.bubble-edge;
                    }
                }
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text {
                        text: root.text;
                        color: root.text-color;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        PixelButton {
                            text: root.cancel-text;
                            clicked => {
                                root.open = false;
                                root.cancel();
                                popup.close();
                            }
                        }
                        PixelButton {
                            text: root.confirm-text;
                            face: root.danger;
                            face-active: #ff2f77;
                            clicked => {
                                root.open = false;
                                root.confirm();
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}