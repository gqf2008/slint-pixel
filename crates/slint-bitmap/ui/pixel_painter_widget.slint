// ============================================================================
// slint-bitmap · 可复用像素风组件库（Slint 1.17）
//
// 本文件是 `@slint_bitmap` 库的唯一入口（file-based library）。
// 其他 Slint 项目可在 build.rs 注册 library path 后，用
//   `import { PixelPainter, PixelTitleBar, Swatch, PixelButton } from "@slint_bitmap"`
// 直接复用本文件导出的组件。
//
// 导出组件：
//   - PixelPainter  ：16×16 像素画板 widget（画布 + 色板 + 工具栏 + 状态栏）
//   - PixelTitleBar ：可拖拽的像素风标题栏（最小化/最大化/关闭，跨平台）
//   - Swatch        ：像素风色块
//   - PixelButton   ：像素风按压按钮
//
// 画布为 16×16 像素网格，每个格子放大为 24px 显示（由 Rust 侧渲染位图，
// 经 `canvas-image` 输入，Rust 通过 `install_painter()` 一键接线）。
// ============================================================================

// ===== 像素标题栏按钮（图标用矩形/通用字形绘制，跨平台） =====
component TitleButton inherits Rectangle {
    in property <string> kind: "min"; // min | max | close
    in property <color> face: #fafafa;
    in property <color> hover-face: #e6e6e6;
    in property <color> icon: #000000;
    callback clicked;
    width: 30px; height: 26px;
    background: ta.has-hover ? root.hover-face : root.face;
    border-width: 1px;
    border-color: root.face;

    // 最小化：横条
    Rectangle {
        visible: root.kind == "min";
        x: 9px; y: 12px; width: 12px; height: 2px;
        background: root.icon;
    }
    // 最大化：方框
    Rectangle {
        visible: root.kind == "max";
        x: 9px; y: 7px; width: 12px; height: 12px;
        background: transparent;
        border-width: 2px;
        border-color: root.icon;
    }
    // 关闭：通用字形 ×（跨平台字体均有）
    Text {
        visible: root.kind == "close";
        text: "×";
        color: root.icon;
        font-size: 16px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

// ===== 像素标题栏（可复用：暴露 drag-start / minimize / toggle-maximize / close-window） =====
export component PixelTitleBar inherits Rectangle {
    in property <string> title: "";
    in property <color> bg: #ffffff;
    in property <color> text-color: #525252;
    in property <color> accent: #000000;
    in property <color> btn-face: #fafafa;
    in property <color> btn-hover: #e6e6e6;
    in property <color> btn-icon: #000000;
    in property <color> close-hover: #ff004d;
    in property <color> divider: #000000;
    callback drag-start;
    callback minimize;
    callback toggle-maximize;
    callback close-window;
    height: 34px;
    background: root.bg;

    // 底层：全宽拖拽热区（声明在最前位于底层，按钮在上层优先接收点击）
    TouchArea {
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                root.drag-start();
            }
        }
        double-clicked => { root.toggle-maximize(); }
    }

    // 左侧 logo
    Rectangle {
        x: 6px; y: 4px; width: 26px; height: 26px;
        background: root.divider;
        Rectangle {
            x: 2px; y: 2px; width: 22px; height: 22px;
            background: root.accent;
        }
    }
    // 标题文字
    Text {
        x: 40px; y: 0px; height: 34px;
        text: root.title;
        color: root.text-color;
        vertical-alignment: center;
        font-weight: 700;
        font-size: 13px;
    }

    // 右侧按钮（锚定右端：3×30 + 2×6 + 右内边距 4 = 106px）
    HorizontalLayout {
        x: parent.width - 106px;
        y: 4px; width: 102px; height: 26px;
        spacing: 6px;
        TitleButton {
            kind: "min"; face: root.btn-face; hover-face: root.btn-hover; icon: root.btn-icon;
            clicked => { root.minimize(); }
        }
        TitleButton {
            kind: "max"; face: root.btn-face; hover-face: root.btn-hover; icon: root.btn-icon;
            clicked => { root.toggle-maximize(); }
        }
        TitleButton {
            kind: "close"; face: root.btn-face; hover-face: root.close-hover; icon: root.btn-icon;
            clicked => { root.close-window(); }
        }
    }
}

// ===== 色块 =====
export component Swatch inherits Rectangle {
    in property <color> fill;
    in property <bool> selected: false;
    in property <color> select-color: #000000;
    in property <color> shade: #000000;
    callback clicked;
    width: 34px;
    height: 34px;
    background: root.shade;
    border-width: 2px;
    border-color: root.selected ? root.select-color : root.shade;
    Rectangle {
        x: 2px; y: 2px; width: 30px; height: 30px;
        background: root.fill;
        TouchArea {
            clicked => { root.clicked(); }
            mouse-cursor: pointer;
        }
    }
}

// ===== 像素风按钮 =====
export component PixelButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> active: false;
    // variant: default | primary | danger | ghost（对齐 Tailwind 按钮语义）
    in property <string> variant: "default";
    // size: small | medium | large
    in property <string> size: "medium";
    in property <color> face: #e6e6e6;
    in property <color> face-active: #000000;
    in property <color> border: #1a1a1a;
    in property <color> border-active: #000000;
    in property <color> text-color: #000000;
    in property <color> shadow: #000000;
    // variant 专用色（默认值随黑白主题）
    in property <color> primary-face: #000000;
    in property <color> primary-text: #ffffff;
    in property <color> danger-face: #dc2626;
    in property <color> danger-text: #ffffff;
    in property <color> ghost-text: #000000;
    callback clicked;

    property <color> eff-face: root.active ? root.face-active
        : (root.variant == "primary" ? root.primary-face
        : (root.variant == "danger" ? root.danger-face
        : (root.variant == "ghost" ? transparent : root.face)));
    property <color> eff-text: root.variant == "primary" ? root.primary-text
        : (root.variant == "danger" ? root.danger-text
        : (root.variant == "ghost" ? root.ghost-text : root.text-color));
    property <length> eff-height: root.size == "small" ? 24px
        : (root.size == "large" ? 42px : 30px);

    height: root.eff-height;
    background: root.shadow;
    Rectangle {
        x: ta.pressed ? 2px : 0px;
        y: ta.pressed ? 2px : 0px;
        width: root.width - (ta.pressed ? 4px : 0px);
        height: root.height - (ta.pressed ? 4px : 0px);
        background: root.eff-face;
        border-width: 2px;
        border-color: root.active ? root.border-active : root.border;
        Text {
            text: root.text;
            color: root.eff-text;
            font-weight: 700;
            font-size: root.size == "small" ? 11px : (root.size == "large" ? 15px : 13px);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        ta := TouchArea {
            clicked => { root.clicked(); }
            mouse-cursor: pointer;
        }
    }
}

// ==================== 画板 widget（可嵌入任意宿主布局） ====================
export component PixelPainter inherits Rectangle {
    // ---------- 主题（宿主可覆盖） ----------
    in property <color> page: #ffffff;          // 画布底色
    in property <color> panel: #fafafa;         // 面板底色
    in property <color> panel-light: #e6e6e6;   // 按钮/高亮面
    in property <color> edge: #1a1a1a;          // 边框/分隔线
    in property <color> shadow: #000000;        // 阴影/描边
    in property <color> text-color: #000000;    // 主文字
    in property <color> dim: #525252;           // 次要文字
    in property <color> highlight: #000000;     // 强调色
    in property <color> danger: #ff004d;        // 危险操作

    // ---------- PICO-8 色板（宿主可覆盖） ----------
    in property <[color]> palette: [
        #000000, #1d2b53, #7e2553, #008751, #ab5236, #5f574f, #c2c3c7, #fff1e8,
        #ff004d, #ffa300, #ffec27, #00e436, #29adff, #83769c, #ff77a8, #ffccaa
    ];

    // ---------- 工具状态（UI 写、Rust 读，可双向同步到宿主） ----------
    in-out property <color> brush-color: #ff004d;
    in-out property <bool> eraser: false;
    in-out property <int> brush-size: 1;
    property <bool> painting: false;
    property <bool> erasing: false;

    // ---------- Rust 驱动的显示状态 ----------
    in-out property <image> canvas-image;
    in-out property <string> status-text: "就绪 —— 左键画 / 右键擦除，点击色板选色";

    // ---------- 回调到 Rust ----------
    callback paint(length, length, bool);
    callback clear-canvas();
    callback save-png();

    preferred-width: 686px;
    preferred-height: 462px;
    clip: true;

    VerticalLayout {
        spacing: 10px;

        // ===== 主区域 =====
        HorizontalLayout {
            spacing: 12px;

            // 画布外框
            Rectangle {
                width: 424px; height: 424px;
                background: root.shadow;
                Rectangle {
                    x: 6px; y: 6px; width: 412px; height: 412px;
                    background: root.edge;
                    Rectangle {
                        x: 4px; y: 4px; width: 404px; height: 404px;
                        background: root.page;
                        Image {
                            x: 10px; y: 10px; width: 384px; height: 384px;
                            source: root.canvas-image;
                            image-rendering: pixelated;
                            TouchArea {
                                pointer-event(ev) => {
                                    if ev.kind == PointerEventKind.down {
                                        if ev.button == PointerEventButton.left {
                                            root.painting = true;
                                            root.paint(self.mouse-x, self.mouse-y, root.eraser);
                                        } else if ev.button == PointerEventButton.right {
                                            root.erasing = true;
                                            root.paint(self.mouse-x, self.mouse-y, true);
                                        }
                                    } else if ev.kind == PointerEventKind.up {
                                        root.painting = false;
                                        root.erasing = false;
                                    }
                                }
                                moved => {
                                    if root.painting {
                                        root.paint(self.mouse-x, self.mouse-y, root.eraser);
                                    } else if root.erasing {
                                        root.paint(self.mouse-x, self.mouse-y, true);
                                    }
                                }
                                mouse-cursor: crosshair;
                            }
                        }
                    }
                }
            }

            // 控制面板
            Rectangle {
                width: 250px;
                background: root.shadow;
                Rectangle {
                    x: 4px; y: 4px; width: 242px; height: parent.height - 8px;
                    background: root.panel;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;

                        Text { text: "调色板 PALETTE"; color: root.text-color; font-weight: 800; letter-spacing: 1px; }
                        GridLayout {
                            spacing: 6px;
                            for c[j] in root.palette : Swatch {
                                col: Math.mod(j, 4);
                                row: Math.floor(j / 4);
                                fill: c;
                                selected: root.brush-color == c;
                                select-color: root.text-color;
                                shade: root.shadow;
                                clicked => {
                                    root.brush-color = c;
                                    root.eraser = false;
                                }
                            }
                        }

                        Rectangle { height: 2px; background: root.edge; }

                        Text { text: "画笔尺寸 BRUSH"; color: root.text-color; font-weight: 800; letter-spacing: 1px; }
                        HorizontalLayout {
                            spacing: 8px;
                            PixelButton {
                                text: "1×1"; width: 62px;
                                active: root.brush-size == 1;
                                clicked => { root.brush-size = 1; }
                            }
                            PixelButton {
                                text: "2×2"; width: 62px;
                                active: root.brush-size == 2;
                                clicked => { root.brush-size = 2; }
                            }
                            PixelButton {
                                text: "3×3"; width: 62px;
                                active: root.brush-size == 3;
                                clicked => { root.brush-size = 3; }
                            }
                        }

                        Text { text: "工具 TOOLS"; color: root.text-color; font-weight: 800; letter-spacing: 1px; }
                        HorizontalLayout {
                            spacing: 8px;
                            PixelButton {
                                text: "画笔"; width: 96px;
                                active: !root.eraser;
                                clicked => { root.eraser = false; }
                            }
                            PixelButton {
                                text: "橡皮擦"; width: 96px;
                                active: root.eraser;
                                clicked => { root.eraser = true; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            PixelButton {
                                text: "清空"; width: 104px;
                                face: root.danger;
                                face-active: #ff2f77;
                                clicked => { root.clear-canvas(); }
                            }
                            PixelButton {
                                text: "存 PNG"; width: 104px;
                                clicked => { root.save-png(); }
                            }
                        }

                        Rectangle { height: 2px; background: root.edge; }

                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "当前笔刷"; color: root.dim; vertical-alignment: center; }
                            Rectangle {
                                width: 28px; height: 28px;
                                background: root.shadow;
                                Rectangle {
                                    x: 2px; y: 2px; width: 24px; height: 24px;
                                    background: root.brush-color;
                                }
                            }
                        }
                    }
                }
            }
        }

        // ===== 状态栏 =====
        Rectangle {
            height: 28px;
            background: root.panel;
            border-width: 2px;
            border-color: root.edge;
            HorizontalLayout {
                padding: 6px;
                Text {
                    text: root.status-text;
                    color: root.dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }
}