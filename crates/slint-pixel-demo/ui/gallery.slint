// slint-pixel 组件画廊：展示全部像素风组件（也是复用教程的完整示例）。

import {
    PixelTitleBar, PixelButton, PixelCheckBox, PixelSwitch, PixelSlider,
    PixelTextInput, PixelProgressBar, PixelBadge, PixelPanel, PixelDialog,
    PixelRadioGroup, PixelComboBox, PixelMenu, PixelTableView, PixelScrollPanel,
    PixelCollapsible, PixelAccordion, PixelSidebar,
    PixelText, PixelTitle, PixelForm, PixelFormItem, PixelTextArea,
    PixelIconButton, PixelTooltip, PixelBubble, PixelPopconfirm,
    PixelAlert, PixelToast, PixelSpinner, PixelSkeleton, PixelTabs,
    PixelBreadcrumb, PixelPagination, PixelDrawer, PixelAvatar, PixelTag,
    PixelCard, PixelNavbar, PixelEmpty, PixelDivider, PixelStat, PixelWindowResize, PixelTheme,
} from "@slint_pixel";


export component GalleryWindow inherits Window {
    title: "Slint 像素组件库";
    no-frame: true;
    preferred-width: 760px;
    preferred-height: 640px;
    background: c-bg;

    // ---------- 主题 ----------
    property <color> c-bg: #ffffff;
    property <color> c-panel: #ffffff;
    property <color> c-panel-light: #f2f2f2;
    property <color> c-border: #1a1a1a;
    property <color> c-shadow: #000000;
    property <color> c-text: #000000;
    property <color> c-dim: #525252;
    property <color> c-highlight: #000000;
    property <color> c-danger: #ff004d;

    // ---------- 演示状态 ----------
    in-out property <bool> grid-enabled: true;
    in-out property <bool> sound-on: false;
    in-out property <float> slider-value: 60.0;
    in-out property <string> input-text: "像素";
    in-out property <int> radio-index: 1;
    in-out property <int> combo-index: 0;
    in-out property <int> menu-index: -1;
    in-out property <int> table-row: -1;
    in-out property <int> accordion-active: 1;
    in-out property <int> sidebar-active: 0;
    property <bool> collapsible-open: true;
    property <bool> dialog-open: false;
    in-out property <string> form-name: "像素小妖";
    in-out property <string> form-desc: "住在森林里的像素生物，会掉落金币。";
    in-out property <int> form-class: 1;
    in-out property <bool> popconfirm-open: false;
    property <bool> bubble-open: false;
    property <string> action-status: "就绪";

    // ---------- 回调（Rust 接线） ----------
    callback drag-start();
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback open-painter();
    callback open-theme-editor();
    callback begin-resize(string);
    callback generate-theme();
    in-out property <string> generated-theme: "";
    // 主题当前值（跟随 PixelTheme，供 Rust 生成样式代码）
    in-out property <color> t-bg: PixelTheme.bg;
    in-out property <color> t-panel: PixelTheme.panel;
    in-out property <color> t-hover: PixelTheme.hover;
    in-out property <color> t-edge: PixelTheme.edge;
    in-out property <color> t-shadow: PixelTheme.shadow;
    in-out property <color> t-text: PixelTheme.text;
    in-out property <color> t-dim: PixelTheme.dim;
    in-out property <color> t-accent: PixelTheme.accent;
    in-out property <color> t-danger: PixelTheme.danger;
    callback dialog-accept();
    callback dialog-cancel();


    VerticalLayout {
        padding: 8px;
        spacing: 10px;

        PixelTitleBar {
            title: "SLINT WIDGET GALLERY · 像素组件库";
            bg: c-bg;
            text-color: c-dim;
            accent: c-highlight;
            btn-face: c-panel;
            btn-hover: c-panel-light;
            btn-icon: c-text;
            close-hover: c-danger;
            divider: c-shadow;
            drag-start => { root.drag-start(); }
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
        }

        // ===== 滚动面板：承载全部组件（单列，滚轮/拖动滚动） =====
        PixelScrollPanel {
            VerticalLayout {
                // 显式宽度：打破 ScrollView 视口宽度 ↔ 内容宽度的循环绑定
                width: root.width - 28px;
                spacing: 10px;
                PixelPanel {
                    title: "按钮 BUTTON · VARIANT / SIZE";
                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            PixelButton { text: "默认"; width: 80px; active: true; }
                            PixelButton { text: "主要"; width: 80px; variant: "primary"; }
                            PixelButton { text: "危险"; width: 80px; variant: "danger"; }
                            PixelButton { text: "幽灵"; width: 80px; variant: "ghost"; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            PixelButton { text: "小"; width: 60px; size: "small"; }
                            PixelButton { text: "中"; width: 60px; }
                            PixelButton { text: "大"; width: 60px; size: "large"; }
                            PixelButton { text: "清空"; width: 80px; face: c-danger; face-active: #ff2f77; }
                        }
                    }
                }
                PixelPanel {
                    title: "复选 / 开关 CHECKBOX · SWITCH";
                    HorizontalLayout {
                        spacing: 12px;
                        PixelCheckBox { text: "启用网格"; width: 100px; checked <=> root.grid-enabled; }
                        PixelCheckBox { text: "自动保存"; width: 100px; }
                        PixelSwitch { checked <=> root.sound-on; }
                    }
                }
                PixelPanel {
                    title: "滑块 SLIDER";
                    VerticalLayout {
                        spacing: 6px;
                        PixelSlider { value <=> root.slider-value; }
                        Text { text: "值: " + Math.round(root.slider-value) + " / 100"; color: c-dim; font-size: 12px; }
                    }
                }
                PixelPanel {
                    title: "输入 TEXT INPUT";
                    VerticalLayout {
                        spacing: 6px;
                        PixelTextInput { text <=> root.input-text; placeholder: "输入文字…"; }
                        Text { text: "回显: " + root.input-text; color: c-dim; font-size: 12px; }
                    }
                }
                PixelPanel {
                    title: "单选框 RADIO";
                    PixelRadioGroup {
                        options: ["像素风", "扁平风", "拟物风"];
                        index <=> root.radio-index;
                    }
                }
                PixelPanel {
                    title: "下拉选择 COMBOBOX";
                    VerticalLayout {
                        spacing: 6px;
                        PixelComboBox {
                            model: ["#ff004d 红", "#ffa300 橙", "#000000 黄", "#00e436 绿", "#000000 蓝"];
                            index <=> root.combo-index;
                        }
                        Text { text: "选中: " + (root.combo-index >= 0 ? "[" + root.combo-index + "]" : "无"); color: c-dim; font-size: 12px; }
                    }
                }
                PixelPanel {
                    title: "进度 PROGRESS";
                    VerticalLayout {
                        spacing: 6px;
                        PixelProgressBar { progress: root.slider-value / 100.0; show-text: true; }
                        PixelProgressBar { progress: 0.35; }
                        PixelProgressBar { progress: 0.85; show-text: true; }
                    }
                }
                PixelPanel {
                    title: "徽章 BADGE";
                    HorizontalLayout {
                        spacing: 8px;
                        PixelBadge { text: "NEW"; width: 60px; face: c-danger; }
                        PixelBadge { text: "PICO-8"; width: 76px; face: c-highlight; }
                        PixelBadge { text: "16×16"; width: 76px; face: #000000; }
                    }
                }
                PixelPanel {
                    title: "提示 TOOLTIP";
                    HorizontalLayout {
                        spacing: 8px;
                        PixelButton {
                            text: "悬停看提示"; width: 120px;
                            // Slint 内置 Tooltip：延迟出现、跟随指针（样式跟随活动主题）
                            Tooltip { text: @markdown("**我是提示气泡**"); }
                        }
                    }
                }
                PixelPanel {
                    title: "菜单 MENU";
                    VerticalLayout {
                        spacing: 6px;
                        PixelMenu {
                            items: ["新建文件", "打开…", "---", "保存", "另存为…", "---", "退出"];
                            index <=> root.menu-index;
                            button-text: "文件菜单";
                        }
                        Text { text: "选择: " + (root.menu-index >= 0 ? root.menu-index : "无"); color: c-dim; font-size: 12px; }
                    }
                }
                PixelPanel {
                    title: "表格 TABLE";
                    PixelTableView {
                        headers: ["精灵", "HP", "攻击"];
                        rows: [
                            ["小妖", "12", "3"],
                            ["骷髅", "20", "5"],
                            ["石魔", "45", "8"],
                            ["龙", "90", "15"]
                        ];
                        selected-row <=> root.table-row;
                    }
                }
                PixelPanel {
                    title: "手风琴 ACCORDION";
                    PixelAccordion {
                        titles: ["第一章 启程", "第二章 森林", "第三章 城堡"];
                        contents: ["你醒来时发现自己在一片像素草地上。", "幽暗的森林里藏着宝箱与陷阱。", "城堡的大门缓缓打开，冒险继续。"];
                        active <=> root.accordion-active;
                    }
                }
                PixelPanel {
                    title: "折叠 COLLAPSIBLE";
                    PixelCollapsible {
                        title: "使用说明";
                        expanded <=> root.collapsible-open;
                        Text {
                            text: "点击标题栏展开/收起。内容区带高度动画。";
                            color: c-text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
                PixelPanel {
                    title: "侧边栏 SIDEBAR";
                    PixelSidebar {
                        height: 160px;
                        items: ["画布", "图层", "调色板", "导出"];
                        active <=> root.sidebar-active;
                        title: "导航";
                        Text {
                            text: "当前页面: " + ["画布", "图层", "调色板", "导出"][root.sidebar-active];
                            color: c-text;
                            font-size: 13px;
                        }
                    }
                }
                PixelPanel {
                    title: "表单 FORM";
                    PixelForm {
                        spacing: 10px;
                        PixelFormItem {
                            label: "名称";
                            PixelTextInput { text <=> root.form-name; }
                        }
                        PixelFormItem {
                            label: "描述";
                            PixelTextArea { text <=> root.form-desc; placeholder: "写点什么…"; }
                        }
                        PixelFormItem {
                            label: "分类";
                            PixelComboBox {
                                model: ["普通", "稀有", "传说"];
                                index <=> root.form-class;
                            }
                        }
                        PixelFormItem {
                            label: "状态";
                            PixelText { text: root.action-status; color: c-dim; }
                        }
                    }
                }
                PixelPanel {
                    title: "文本 TEXT";
                    VerticalLayout {
                        spacing: 6px;
                        PixelTitle { text: "像素小标题 PIXEL TITLE"; }
                        PixelText { text: "正文：这是一段像素风文本，用 PixelText 统一字号。"; }
                        PixelText { text: "次要说明文字，用 color 覆盖即可。"; color: c-dim; }
                    }
                }
                PixelPanel {
                    title: "图标按钮 ICON";
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            PixelIconButton { icon: "×"; clicked => { root.action-status = "点击了关闭图标"; } }
                            // 右上角数字角标（PixelBadge 作角标）
                            PixelBadge { text: "3"; x: 24px; y: -6px; width: 22px; height: 16px; face: c-danger; text-color: #ffffff; font-size: 10px; }
                        }
                        PixelIconButton { icon: "✓"; clicked => { root.action-status = "点击了确认图标"; } }
                        PixelIconButton { icon: "▲"; active: true; clicked => { root.action-status = "点击了上箭头"; } }
                        PixelIconButton { icon: "★"; clicked => { root.action-status = "点击了星标"; } }
                        PixelIconButton { icon: "♥"; clicked => { root.action-status = "点击了爱心"; } }
                    }
                }
                PixelPanel {
                    title: "气泡 TOOLTIP · BUBBLE";
                    HorizontalLayout {
                        spacing: 12px;
                        PixelTooltip {
                            text: "这是像素风悬停提示气泡";
                            PixelButton { text: "悬停我"; width: 90px; }
                        }
                        PixelBubble {
                            icon: "ⓘ";
                            title: "使用说明";
                            open: root.bubble-open;
                            PixelText { text: "气泡内容插槽可以放任意组件，点外部自动关闭。"; }
                            PixelButton {
                                text: "知道了"; width: 90px;
                                clicked => { root.bubble-open = false; }
                            }
                        }
                    }
                }
                PixelPanel {
                    title: "确认 POPCONFIRM";
                    VerticalLayout {
                        spacing: 6px;
                        PixelPopconfirm {
                            text: "确定要删除这个像素小妖吗？此操作不可撤销。";
                            button-text: "删除角色";
                            open: root.popconfirm-open;
                            confirm => { root.action-status = "已确认删除"; }
                            cancel => { root.action-status = "已取消删除"; }
                        }
                        PixelText { text: root.action-status; color: c-dim; }
                    }
                }
                PixelPanel {
                    title: "警告 ALERT";
                    VerticalLayout {
                        spacing: 6px;
                        PixelAlert { kind: "info"; text: "这是信息提示条 info"; }
                        PixelAlert { kind: "success"; text: "操作成功 success"; }
                        PixelAlert { kind: "warning"; text: "注意：磁盘空间不足 warning"; }
                        PixelAlert { kind: "error"; text: "保存失败 error"; closable: false; }
                    }
                }
                PixelPanel {
                    title: "通知 TOAST · 加载 SPINNER · 骨架 SKELETON";
                    VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            PixelToast { text: "像素通知：已保存"; shown: true; duration: 9999s; }
                            PixelSpinner { }
                            PixelSpinner { size: 40px; }
                        }
                        PixelSkeleton { frame-height: 14px; }
                        PixelSkeleton { frame-height: 14px; pulse: false; }
                    }
                }
                PixelPanel {
                    title: "标签页 TABS";
                    VerticalLayout {
                        spacing: 6px;
                        PixelTabs {
                            tabs: ["画布", "图层", "导出"];
                            active: 1;
                        }
                        PixelText { text: "当前标签内容区由宿主切换（active 索引）。"; color: c-dim; }
                    }
                }
                PixelPanel {
                    title: "面包屑 BREADCRUMB · 分页 PAGINATION";
                    VerticalLayout {
                        spacing: 10px;
                        PixelBreadcrumb { items: ["首页", "素材", "像素小妖"]; }
                        PixelPagination { page: 2; total: 5; }
                    }
                }
                PixelPanel {
                    title: "头像 AVATAR · 标签 TAG";
                    HorizontalLayout {
                        spacing: 12px;
                        PixelAvatar { text: "P"; }
                        PixelAvatar { text: "妖"; }
                        PixelTag { text: "像素"; }
                        PixelTag { text: "稀有"; closable: true; }
                    }
                }
                PixelPanel {
                    title: "卡片 CARD";
                    PixelCard {
                        title: "像素小妖";
                        width: 260px;
                        PixelText { text: "稀有度：传说"; }
                        PixelText { text: "掉落：金币 × 12"; color: c-dim; }
                        PixelButton { text: "查看详情"; width: 100px; size: "small"; }
                    }
                }
                PixelPanel {
                    title: "顶栏 NAVBAR";
                    PixelNavbar {
                        brand: "PIXEL";
                        items: ["首页", "素材", "作品"];
                        active: 0;
                    }
                }
                PixelPanel {
                    title: "空状态 EMPTY · 分隔线 DIVIDER · 统计 STAT";
                    VerticalLayout {
                        spacing: 10px;
                        PixelEmpty {
                            title: "还没有像素素材";
                            description: "点击下方按钮开始创作";
                            height: 140px;
                            PixelButton { text: "去创作"; width: 90px; variant: "primary"; }
                        }
                        PixelDivider { text: "分隔线"; }
                        HorizontalLayout {
                            spacing: 10px;
                            PixelStat { label: "今日作品"; value: "128"; delta: "12.5%"; }
                            PixelStat { label: "金币"; value: "9,999"; delta: "-3.2%"; delta-up: false; }
                        }
                    }
                }
                PixelPanel {
                    title: "对话框 DIALOG";
                    HorizontalLayout {
                        spacing: 8px;
                        PixelButton {
                            text: "打开对话框"; width: 140px;
                            clicked => { root.dialog-open = true; }
                        }
                    }
                }
                PixelPanel {
                    title: "画板 PAINTER · 主题 EDITOR";
                    HorizontalLayout {
                        spacing: 8px;
                        PixelButton {
                            text: "打开画板"; width: 110px; variant: "primary";
                            clicked => { root.open-painter(); }
                        }
                        PixelButton {
                            text: "主题编辑器"; width: 100px; variant: "primary";
                            clicked => { root.open-theme-editor(); }
                        }
                    }
                }
            }
        }
    }

    // ===== 无边框窗口缩放热区（内容之上、对话框之下） =====
    PixelWindowResize {
        begin-resize(dir) => { root.begin-resize(dir); }
    }

    // ===== 模态对话框（覆盖层） =====
    PixelDialog {
        open: root.dialog-open;
        title: "像素对话框";
        Text {
            text: "这是 PixelDialog 的内容插槽，可以放任意组件。点击确定或取消关闭。";
            color: c-text;
            font-size: 13px;
            wrap: word-wrap;
        }
        accept => {
            root.dialog-accept();
            root.dialog-open = false;
        }
        cancel => {
            root.dialog-cancel();
            root.dialog-open = false;
        }
    }
}
