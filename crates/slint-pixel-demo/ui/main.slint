// slint-pixel 演示窗口：下游消费者的最小示例。
// 与 slint-pixel 库内的 PixelPainterWindow 等价，这里以“消费者”身份
// 通过 `@slint_pixel` 导入组件并自行组装，验证组件库的可复用性。

import { PixelPainter, PixelTitleBar, PixelWindowResize, PixelWindowBody, PixelTheme, PixelPresets } from "@slint_pixel";

export component MainWindow inherits Window {
    title: "Slint 像素画板";
    no-frame: true;
    preferred-width: 720px;
    preferred-height: 560px;
    min-width: 720px;
    min-height: 560px;
    background: transparent;

    // ---------- 与画板 widget 双向同步的状态 ----------
    in-out property <color> brush-color: #ff004d;
    in-out property <bool> eraser: false;
    in-out property <int> brush-size: 1;
    in-out property <image> canvas-image;
    in-out property <string> status-text: "就绪 —— 左键画 / 右键擦除，点击色板选色";
    // 默认预设：soft 柔彩 + 圆角（画廊开箱观感）；无头截图 / 演示脚本可显式切 "classic" / "dark"。
    // 初始声明值不触发 changed，故抽公共函数 + init 显式套用一次。
    in-out property <string> theme-preset: "soft";
    changed theme-preset => { root.apply-theme-preset(); }
    init => { root.apply-theme-preset(); }

    function apply-theme-preset() {
        if (root.theme-preset == "soft") {
            PixelPresets.soft();
            PixelTheme.window-radius = 12px;
        } else if (root.theme-preset == "dark") {
            PixelPresets.dark();
            PixelTheme.window-radius = 0px;
        } else {
            PixelPresets.classic();
            PixelTheme.window-radius = 0px;
        }
    }

    // ---------- 转发回调（Rust 侧用 install_painter / install_title_bar_controls 接线） ----------
    callback paint(length, length, bool);
    callback clear-canvas();
    callback save-png();
    callback drag-start();
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback begin-resize(string);

    // 圆角窗身：window-radius = 0 时 pad = 0、无描边，退回原来的全出血观感
    PixelWindowBody {
        VerticalLayout {
            padding: 8px;
            spacing: 10px;

            PixelTitleBar {
                title: "SLINT PIXEL PAINTER · 像素画板";
                bg: PixelTheme.bg;
                text-color: PixelTheme.dim;
                accent: PixelTheme.accent;
                btn-face: PixelTheme.panel;
                btn-hover: PixelTheme.hover;
                btn-icon: PixelTheme.text;
                close-hover: PixelTheme.danger;
                divider: PixelTheme.shadow;
                drag-start => { root.drag-start(); }
                minimize => { root.minimize(); }
                toggle-maximize => { root.toggle-maximize(); }
                close-window => { root.close-window(); }
            }

            PixelPainter {
                page: PixelTheme.bg;
                panel: PixelTheme.panel;
                panel-light: PixelTheme.hover;
                edge: PixelTheme.edge;
                shadow: PixelTheme.shadow;
                text-color: PixelTheme.text;
                dim: PixelTheme.dim;
                highlight: PixelTheme.accent;
                danger: PixelTheme.danger;

                brush-color <=> root.brush-color;
                eraser <=> root.eraser;
                brush-size <=> root.brush-size;
                canvas-image <=> root.canvas-image;
                status-text <=> root.status-text;

                paint(px, py, erase) => { root.paint(px, py, erase); }
                clear-canvas => { root.clear-canvas(); }
                save-png => { root.save-png(); }
            }
        }
    }

    // ===== 无边框窗口缩放热区（内容之上） =====
    PixelWindowResize {
        begin-resize(dir) => { root.begin-resize(dir); }
    }
}
